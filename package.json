{
  "name": "inventory-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:phase5g:static": "node --test tests/static/phase5g.source-regression.test.mjs",
    "test:phase5g:rules": "firebase emulators:exec --only firestore --project demo-inventory-phase5g \"node --test tests/firestore/phase5g.stockout.rules.test.mjs\"",
    "test:phase5g": "npm run lint && npm run build && npm run test:phase5g:static && npm run test:phase5g:rules",
    "test:phase7a10:static": "node --test tests/static/phase7a10.reporting-foundation.test.mjs",
    "lint": "oxlint src",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "latest",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.76.0",
    "vite": "^8.2.0"
  }
}
