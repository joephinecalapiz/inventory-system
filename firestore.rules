rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Returns true when Firebase Authentication
     * has identified a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /*
     * Returns true when the signed-in user has
     * a matching Firestore profile.
     */
    function userProfileExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    /*
     * Returns the logged-in user's Firestore profile.
     */
    function currentUserProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    /*
     * Only ACTIVE accounts may use protected
     * inventory collections.
     */
    function isActiveUser() {
      return userProfileExists()
        && currentUserProfile().status == "ACTIVE";
    }

    /*
     * Checks whether the active user's role appears
     * inside the supplied list of allowed roles.
     */
    function hasRole(allowedRoles) {
      return isActiveUser()
        && currentUserProfile().role in allowedRoles;
    }
    /*
 * Checks whether the current account is a
 * Super Administrator.
 */
function isSuperAdmin() {
  return hasRole([
    "SUPERADMIN"
  ]);
}

/*
 * Checks whether the current account is an
 * Administrator.
 */
function isAdmin() {
  return hasRole([
    "ADMIN"
  ]);
}

/*
 * Valid roles that may be saved in a user profile.
 */
function isValidManagedRole(role) {
  return role in [
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "CASHIER",
    "AUDITOR"
  ];
}

/*
 * Valid account statuses.
 */
function isValidManagedStatus(status) {
  return status in [
    "ACTIVE",
    "INACTIVE",
    "SUSPENDED"
  ];
}

/*
 * Allows only access-related fields to change.
 *
 * Fields such as email and displayName cannot be
 * changed through this operation.
 */
function onlyUserAccessFieldsChanged() {
  return request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "role",
      "status",
      "updatedBy",
      "updatedAt"
    ]);
}

/*
 * Administrators may manage operational accounts,
 * but cannot manage or assign ADMIN or SUPERADMIN.
 */
function adminCanManageTargetUser() {
  return resource.data.role in [
      "INVENTORY_STAFF",
      "CASHIER",
      "AUDITOR"
    ]
    && request.resource.data.role in [
      "INVENTORY_STAFF",
      "CASHIER",
      "AUDITOR"
    ];
}
    
    

 match /users/{userId} {

  /*
   * Users may read their own profile.
   * Superadmin and Admin may read other profiles.
   */
  allow get: if isSignedIn()
    && (
      request.auth.uid == userId
      || hasRole([
        "SUPERADMIN",
        "ADMIN"
      ])
    );

  /*
   * Superadmin and Admin may list users for
   * the User Management page.
   */
  allow list: if hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);

  /*
   * Role and status updates.
   */
  allow update: if isActiveUser()

    /*
     * Administrators cannot change their own
     * role or status.
     */
    && request.auth.uid != userId

    /*
     * Do not allow unrelated user-profile
     * fields to be changed.
     */
    && onlyUserAccessFieldsChanged()

    /*
     * Validate the new values.
     */
    && isValidManagedRole(
      request.resource.data.role
    )

    && isValidManagedStatus(
      request.resource.data.status
    )

    /*
     * Record who performed the change.
     */
    && request.resource.data.updatedBy
      == request.auth.uid

    /*
     * The timestamp must come from Firestore.
     */
    && request.resource.data.updatedAt
      == request.time

    /*
     * Superadmin may manage other users.
     *
     * Admin may only manage operational roles.
     */
    && (
      isSuperAdmin()
      || (
        isAdmin()
        && adminCanManageTargetUser()
      )
    );

  /*
   * Account creation will be handled in
   * Phase 1F-3.
   *
   * Account deletion remains disabled.
   */
  allow create, delete: if false;
}
     
     
     
    /*
 * PRODUCT MASTER AND STOCK BALANCE HELPERS
 */
function canReadProducts() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "CASHIER",
    "AUDITOR"
  ]);
}

function canManageProducts() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
}

function isValidProductStatusValue(value) {
  return value in [
    "ACTIVE",
    "INACTIVE"
  ];
}

function isValidProductMoneyValue(value) {
  return value is number
    && value >= 0
    && value <= 999999999;
}

function isValidOptionalProductCost(value) {
  return value == null
    || isValidProductMoneyValue(value);
}

function isValidProductWholeNumber(value) {
  return value is int
    && value >= 0
    && value <= 999999999;
}

/*
 * Normalized product stock status used by reports and dashboard queries.
 */
function hasValidProductStockStatus(data) {
  return data.stockStatus in [
      "IN_STOCK",
      "LOW_STOCK",
      "OUT_OF_STOCK"
    ]
    && (
      (
        data.quantity == 0
        && data.stockStatus == "OUT_OF_STOCK"
      )
      ||
      (
        data.quantity > 0
        && data.quantity <= data.reorderLevel
        && data.stockStatus == "LOW_STOCK"
      )
      ||
      (
        data.quantity > data.reorderLevel
        && data.stockStatus == "IN_STOCK"
      )
    );
}

function isValidOptionalProductSource(data) {
  return !data.keys().hasAny([
      "sourceProductId"
    ])
    || (
      data.sourceProductId is string
      && data.sourceProductId.size() >= 1
      && data.sourceProductId.size() <= 100
      && data.sourceProductId.matches(
        "^[A-Za-z0-9_-]+$"
      )
    );
}

function productCategorySnapshotMatches(data) {
  let category = get(
    /databases/$(database)/documents/categories/$(data.categoryCode)
  ).data;

  return category.status == "ACTIVE"
    && category.code == data.categoryCode
    && category.name == data.category
    && category.name == data.categoryName
    && category.barcodePrefix == data.barcodePrefix;
}

function productUnitSnapshotMatches(data) {
  let unit = get(
    /databases/$(database)/documents/units/$(data.unitCode)
  ).data;

  return unit.status == "ACTIVE"
    && unit.code == data.unitCode
    && unit.name == data.unitName
    && unit.abbreviation == data.unitAbbreviation;
}

function productBarcodeCounterMatchesCreate(data) {
  let counter = getAfter(
    /databases/$(database)/documents/barcodeCounters/$(data.barcodePrefix)
  ).data;

  return counter.categoryCode == data.categoryCode
    && counter.barcodePrefix == data.barcodePrefix
    && counter.lastSequence == data.barcodeSequence
    && counter.updatedBy == request.auth.uid
    && counter.updatedAt == request.time;
}

function productSourceReservationMatches(data, productId) {
  return !data.keys().hasAny([
      "sourceProductId"
    ])
    || (
      getAfter(
        /databases/$(database)/documents/productMasterReservations/$(data.sourceProductId)
      ).data.productId == productId
      && getAfter(
        /databases/$(database)/documents/productMasterReservations/$(data.sourceProductId)
      ).data.sku == data.sku
      && getAfter(
        /databases/$(database)/documents/productMasterReservations/$(data.sourceProductId)
      ).data.createdBy == request.auth.uid
      && getAfter(
        /databases/$(database)/documents/productMasterReservations/$(data.sourceProductId)
      ).data.createdAt == request.time
    );
}

function isValidNewProduct(data, productId) {
  return data.keys().hasOnly([
      "sourceProductId",
      "name",
      "sku",
      "description",
      "status",
      "category",
      "categoryName",
      "categoryCode",
      "categoryId",
      "barcodePrefix",
      "unitCode",
      "unitId",
      "unitName",
      "unitAbbreviation",
      "costPrice",
      "sellingPrice",
      "price",
      "quantity",
      "reorderLevel",
      "stockStatus",
      "barcode",
      "barcodeSequence",
      "hasStockHistory",
      "stockMovementCount",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])
    && data.keys().hasAll([
      "name",
      "sku",
      "description",
      "status",
      "category",
      "categoryName",
      "categoryCode",
      "categoryId",
      "barcodePrefix",
      "unitCode",
      "unitId",
      "unitName",
      "unitAbbreviation",
      "costPrice",
      "sellingPrice",
      "price",
      "quantity",
      "reorderLevel",
      "stockStatus",
      "barcode",
      "barcodeSequence",
      "hasStockHistory",
      "stockMovementCount",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])
    && isValidOptionalProductSource(data)
    && data.name is string
    && data.name.size() >= 2
    && data.name.size() <= 150
    && data.sku is string
    && data.sku.matches(
      "^[A-Z0-9][A-Z0-9#&._/ -]{1,49}$"
    )
    && data.description is string
    && data.description.size() <= 500
    && isValidProductStatusValue(data.status)
    && data.status == "ACTIVE"
    && data.category is string
    && data.category.size() >= 2
    && data.category.size() <= 150
    && data.categoryName == data.category
    && data.categoryCode is string
    && data.categoryCode.matches(
      "^[A-Z0-9_]{2,50}$"
    )
    && data.categoryId == data.categoryCode
    && data.barcodePrefix is string
    && data.barcodePrefix.matches(
      "^[0-9]{2}$"
    )
    && data.unitCode is string
    && data.unitCode.matches(
      "^[A-Z0-9_]{1,50}$"
    )
    && data.unitId == data.unitCode
    && data.unitName is string
    && data.unitName.size() >= 1
    && data.unitName.size() <= 100
    && data.unitAbbreviation is string
    && data.unitAbbreviation.matches(
      "^[A-Z0-9]{1,10}$"
    )
    && isValidOptionalProductCost(data.costPrice)
    && isValidProductMoneyValue(data.sellingPrice)
    && data.price == data.sellingPrice
    && isValidProductWholeNumber(data.quantity)
    && isValidProductWholeNumber(data.reorderLevel)
    && hasValidProductStockStatus(data)
    && data.barcode is string
    && data.barcode.matches(
      "^[0-9]{12}$"
    )
    && data.barcode[0:2] == data.barcodePrefix
    && data.barcodeSequence is int
    && data.barcodeSequence >= 1
    && data.barcodeSequence <= 999999999
    && int(data.barcode[2:11]) == data.barcodeSequence
    && data.hasStockHistory == false
    && data.stockMovementCount == 0
    && data.createdBy == request.auth.uid
    && data.createdAt == request.time
    && data.updatedBy == request.auth.uid
    && data.updatedAt == request.time
    && productCategorySnapshotMatches(data)
    && productUnitSnapshotMatches(data)
    && productBarcodeCounterMatchesCreate(data)
    && productSourceReservationMatches(
      data,
      productId
    );
}

function isValidProductMasterUpdate() {
  return request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "name",
        "description",
        "costPrice",
        "sellingPrice",
        "price",
        "reorderLevel",
        "stockStatus",
        "status",
        "updatedBy",
        "updatedAt"
      ])
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 150
    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500
    && isValidOptionalProductCost(
      request.resource.data.costPrice
    )
    && isValidProductMoneyValue(
      request.resource.data.sellingPrice
    )
    && request.resource.data.price
      == request.resource.data.sellingPrice
    && isValidProductWholeNumber(
      request.resource.data.reorderLevel
    )
    && isValidProductStatusValue(
      request.resource.data.status
    )
    && hasValidProductStockStatus(
      request.resource.data
    )
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time;
}

function isValidProductUnitAssignment() {
  return request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "unitCode",
        "unitId",
        "unitName",
        "unitAbbreviation",
        "updatedBy",
        "updatedAt"
      ])
    && (
      resource.data.get(
        "unitCode",
        ""
      ) == ""
      || resource.data.get(
        "unitCode",
        ""
      ) == request.resource.data.unitCode
    )
    && request.resource.data.unitCode is string
    && request.resource.data.unitCode.matches(
      "^[A-Z0-9_]{1,50}$"
    )
    && request.resource.data.unitId
      == request.resource.data.unitCode
    && request.resource.data.unitName is string
    && request.resource.data.unitName.size() >= 1
    && request.resource.data.unitName.size() <= 100
    && request.resource.data.unitAbbreviation is string
    && request.resource.data.unitAbbreviation.matches(
      "^[A-Z0-9]{1,10}$"
    )
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time
    && productUnitSnapshotMatches(
      request.resource.data
    );
}

function isValidProductSourceAssignment(productId) {
  return hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "sourceProductId",
        "sourceIdentityAssignedBy",
        "sourceIdentityAssignedAt",
        "updatedBy",
        "updatedAt"
      ])
    && resource.data.get(
      "sourceProductId",
      ""
    ) == ""
    && request.resource.data.sourceProductId
      is string
    && request.resource.data.sourceProductId.matches(
      "^[A-Za-z0-9_-]{1,100}$"
    )
    && request.resource.data.sourceIdentityAssignedBy
      == request.auth.uid
    && request.resource.data.sourceIdentityAssignedAt
      == request.time
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time
    && getAfter(
      /databases/$(database)/documents/productMasterReservations/$(request.resource.data.sourceProductId)
    ).data.productId == productId
    && getAfter(
      /databases/$(database)/documents/productMasterReservations/$(request.resource.data.sourceProductId)
    ).data.sku == request.resource.data.sku;
}

function isValidProductMigrationUpdate() {
  return hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "description",
        "costPrice",
        "sellingPrice",
        "price",
        "hasStockHistory",
        "stockMovementCount",
        "legacyMigrationVersion",
        "legacyMigratedBy",
        "legacyMigratedAt",
        "updatedBy",
        "updatedAt"
      ])
    && isValidProductStatusValue(
      request.resource.data.status
    )
    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500
    && isValidOptionalProductCost(
      request.resource.data.costPrice
    )
    && isValidProductMoneyValue(
      request.resource.data.sellingPrice
    )
    && request.resource.data.price
      == request.resource.data.sellingPrice
    && request.resource.data.hasStockHistory is bool
    && request.resource.data.stockMovementCount is int
    && request.resource.data.stockMovementCount >= 0
    && request.resource.data.legacyMigrationVersion == 1
    && request.resource.data.legacyMigratedBy
      == request.auth.uid
    && request.resource.data.legacyMigratedAt
      == request.time
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time;
}

function isValidStockOutOperationId(value) {
  return value is string
    && value.matches(
      "^stockout_[A-Za-z0-9_-]{7,91}$"
    );
}

function isValidStockOutReason(value) {
  return value in [
    "MANUAL_STOCK_OUT",
    "DAMAGED",
    "EXPIRED",
    "INTERNAL_USE",
    "TRANSFER",
    "SAMPLE",
    "LOSS",
    "OTHER"
  ];
}

function stockOutReasonRequiresDestination(value) {
  return value in [
    "INTERNAL_USE",
    "TRANSFER",
    "SAMPLE"
  ];
}

function isValidStockOutDestinationValue(
  value,
  reason
) {
  return value is string
    && value.size() <= 150
    && (
      !stockOutReasonRequiresDestination(
        reason
      )
      || value.size() >= 1
    );
}

function hasValidProductStockAuditUpdate() {
  return request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "quantity",
        "stockStatus",
        "costPrice",
        "hasStockHistory",
        "stockMovementCount",
        "lastStockMovementId",
        "lastStockMovementType",
        "lastStockMovementReason",
        "lastStockMovementQuantity",
        "lastStockMovementUnitCost",
        "lastStockMovementAt",
        "lastStockMovementBy",
        "updatedBy",
        "updatedAt"
      ])
    && isValidProductWholeNumber(
      resource.data.quantity
    )
    && isValidProductWholeNumber(
      request.resource.data.quantity
    )
    && request.resource.data.hasStockHistory == true
    && request.resource.data.stockMovementCount is int
    && request.resource.data.stockMovementCount
      == resource.data.get(
        "stockMovementCount",
        0
      ) + 1
    && request.resource.data.lastStockMovementId
      is string
    && request.resource.data.lastStockMovementId.matches(
      "^[A-Za-z0-9_-]{1,128}$"
    )
    && request.resource.data.lastStockMovementType in [
      "IN",
      "OUT"
    ]
    && request.resource.data.lastStockMovementReason
      is string
    && request.resource.data.lastStockMovementQuantity
      is int
    && request.resource.data.lastStockMovementQuantity >= 1
    && request.resource.data.lastStockMovementQuantity <= 999999999
    && request.resource.data.lastStockMovementUnitCost
      is number
    && request.resource.data.lastStockMovementUnitCost >= 0
    && request.resource.data.lastStockMovementUnitCost <= 999999999
    && request.resource.data.lastStockMovementAt
      == request.time
    && request.resource.data.get(
      "lastStockMovementBy",
      request.auth.uid
    ) == request.auth.uid
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time
    && hasValidProductStockStatus(
      request.resource.data
    );
}

function isValidProductStockIncreaseBase() {
  return request.resource.data.lastStockMovementType
      == "IN"
    && request.resource.data.lastStockMovementReason in [
      "MANUAL_STOCK_IN",
      "PURCHASE_RECEIPT",
      "RETURNED_STOCK",
      "OPENING_BALANCE",
      "OTHER"
    ]
    && request.resource.data.quantity
      == resource.data.quantity
        + request.resource.data.lastStockMovementQuantity
    && (
      !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          "costPrice"
        ])
      || (
        request.resource.data.lastStockMovementUnitCost > 0
        && isValidOptionalProductCost(
          request.resource.data.costPrice
        )
        && request.resource.data.costPrice
          == request.resource.data.lastStockMovementUnitCost
      )
    );
}

function manualStockInProductMatchesMovementAndOperation(
  productId
) {
  let operationId =
    request.resource.data.lastStockMovementId;

  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(operationId)
  ).data;

  let operation = getAfter(
    /databases/$(database)/documents/stockInOperations/$(operationId)
  ).data;

  return movement.movementId == operationId
    && movement.operationId == operationId
    && movement.movementType == "IN"
    && movement.reason
      == request.resource.data.lastStockMovementReason
    && movement.productId == productId
    && movement.productName == resource.data.name
    && movement.productSku == resource.data.sku
    && movement.quantity
      == request.resource.data.lastStockMovementQuantity
    && movement.previousQuantity
      == resource.data.quantity
    && movement.newQuantity
      == request.resource.data.quantity
    && movement.unitCost
      == request.resource.data.lastStockMovementUnitCost
    && movement.receivedBy == request.auth.uid
    && movement.createdBy == request.auth.uid
    && movement.createdAt == request.time
    && operation.operationId == operationId
    && operation.status == "COMPLETED"
    && operation.movementId == operationId
    && operation.productId == productId
    && operation.productName == movement.productName
    && operation.productSku == movement.productSku
    && operation.quantityReceived == movement.quantity
    && operation.previousQuantity
      == movement.previousQuantity
    && operation.newQuantity == movement.newQuantity
    && operation.unitCost == movement.unitCost
    && operation.totalCost == movement.totalCost
    && operation.source == movement.source
    && operation.referenceNumber
      == movement.referenceNumber
    && operation.dateReceived == movement.dateReceived
    && operation.reason == movement.reason
    && operation.remarks
      == movement.get(
        "remarks",
        ""
      )
    && operation.receivedBy == request.auth.uid
    && operation.receivedByName
      == movement.receivedByName
    && operation.createdBy == request.auth.uid
    && operation.createdAt == request.time;
}

function stockOutProductMatchesMovementAndOperation(
  productId
) {
  let operationId =
    request.resource.data.lastStockMovementId;

  let operation = getAfter(
    /databases/$(database)/documents/stockOutOperations/$(operationId)
  ).data;

  return operation.operationId == operationId
    && operation.status == "COMPLETED"
    && operation.movementId == operationId
    && operation.productId == productId
    && operation.productName == resource.data.name
    && operation.productSku == resource.data.sku
    && operation.quantityReleased
      == request.resource.data.lastStockMovementQuantity
    && operation.previousQuantity
      == resource.data.quantity
    && operation.newQuantity
      == request.resource.data.quantity
    && operation.unitCost
      == request.resource.data.lastStockMovementUnitCost
    && operation.reason
      == request.resource.data.lastStockMovementReason
    && operation.releasedBy == request.auth.uid
    && operation.createdBy == request.auth.uid
    && operation.createdAt == request.time;
}



/*
 * PHASE 6G - STOCK ADJUSTMENT SECURITY HELPERS
 */

function canReadStockAdjustments() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);
}

function canCreateStockAdjustmentRequest() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
}

function canReviewStockAdjustmentRequest() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);
}

function isValidStockAdjustmentId(value) {
  return value is string
    && value.size() >= 16
    && value.size() <= 100
    && value.matches(
      "^stockadj_[A-Za-z0-9_-]+$"
    );
}

function isValidStockAdjustmentOperationId(
  value
) {
  return value is string
    && value.size() >= 20
    && value.size() <= 120
    && value.matches(
      "^stockadj_(create|post|reject|cancel)_[A-Za-z0-9_-]+$"
    );
}

function isValidStockAdjustmentReason(
  value
) {
  return value in [
    "PHYSICAL_COUNT_CORRECTION",
    "ENCODING_ERROR",
    "DAMAGED_FOUND_DURING_COUNT",
    "EXPIRED_FOUND_DURING_COUNT",
    "UNRECORDED_STOCK_FOUND",
    "LOSS_OR_SHORTAGE",
    "UNIT_CONVERSION_CORRECTION",
    "OTHER"
  ];
}

function isValidStockAdjustmentDirection(
  value
) {
  return value in [
    "IN",
    "OUT"
  ];
}

function stockAdjustmentReasonMatchesDirection(
  reason,
  direction
) {
  return isValidStockAdjustmentReason(
      reason
    )
    && isValidStockAdjustmentDirection(
      direction
    )
    && (
      (
        reason
          == "UNRECORDED_STOCK_FOUND"
        && direction == "IN"
      )
      ||
      (
        reason in [
          "DAMAGED_FOUND_DURING_COUNT",
          "EXPIRED_FOUND_DURING_COUNT",
          "LOSS_OR_SHORTAGE"
        ]
        && direction == "OUT"
      )
      ||
      reason in [
        "PHYSICAL_COUNT_CORRECTION",
        "ENCODING_ERROR",
        "UNIT_CONVERSION_CORRECTION",
        "OTHER"
      ]
    );
}

function stockAdjustmentDifferenceMatches(
  systemQuantity,
  actualQuantity,
  difference,
  direction
) {
  return systemQuantity is int
    && systemQuantity >= 0
    && systemQuantity <= 999999999
    && actualQuantity is int
    && actualQuantity >= 0
    && actualQuantity <= 999999999
    && difference is int
    && difference != 0
    && difference
      == actualQuantity - systemQuantity
    && (
      (
        difference > 0
        && direction == "IN"
      )
      ||
      (
        difference < 0
        && direction == "OUT"
      )
    );
}

function stockAdjustmentAbsoluteQuantityMatches(
  quantity,
  difference
) {
  return quantity is int
    && quantity >= 1
    && quantity <= 999999999
    && (
      (
        difference > 0
        && quantity == difference
      )
      ||
      (
        difference < 0
        && quantity == 0 - difference
      )
    );
}

function isValidStockAdjustmentMoney(
  value
) {
  return value is number
    && value >= 0
    && value <= 999999999999.99;
}

function stockAdjustmentValueMatches(
  quantity,
  unitCost,
  totalValue
) {
  return quantity is int
    && quantity >= 1
    && unitCost is number
    && unitCost >= 0
    && unitCost <= 999999999
    && isValidStockAdjustmentMoney(
      totalValue
    )
    && totalValue
      >= quantity * unitCost - 0.01
    && totalValue
      <= quantity * unitCost + 0.01;
}

function isValidStockAdjustmentCountDate(
  dateValue,
  dateKey
) {
  return dateValue is timestamp
    && dateValue <= request.time
    && dateKey is string
    && dateKey.matches(
      "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    );
}

function hasValidStockAdjustmentOptionalSnapshots(
  data
) {
  return (
      !data.keys().hasAny([
        "barcode"
      ])
      || (
        data.barcode is string
        && data.barcode.size() <= 150
      )
    )
    && (
      !data.keys().hasAny([
        "category"
      ])
      || (
        data.category is string
        && data.category.size() <= 150
      )
    )
    && (
      !data.keys().hasAny([
        "categoryCode"
      ])
      || (
        data.categoryCode is string
        && data.categoryCode.size() <= 100
      )
    )
    && (
      !data.keys().hasAny([
        "unitCode"
      ])
      || (
        data.unitCode is string
        && data.unitCode.size() <= 100
      )
    )
    && (
      !data.keys().hasAny([
        "unitName"
      ])
      || (
        data.unitName is string
        && data.unitName.size() <= 100
      )
    )
    && (
      !data.keys().hasAny([
        "unitAbbreviation"
      ])
      || (
        data.unitAbbreviation is string
        && data.unitAbbreviation.size() <= 50
      )
    );
}

function stockAdjustmentRequestMatchesProduct(
  data
) {
  let product = get(
    /databases/$(database)/documents/products/$(data.productId)
  ).data;

  return product.get(
      "status",
      "ACTIVE"
    ) == "ACTIVE"
    && product.quantity
      == data.systemQuantityAtRequest
    && product.name == data.productName
    && product.sku == data.productSku
    && data.unitCostAtRequest
      == product.get(
        "costPrice",
        0
      );
}

function stockAdjustmentCreateOperationMatchesRequest(
  data,
  adjustmentId
) {
  let operation = getAfter(
    /databases/$(database)/documents/stockAdjustmentOperations/$(data.createOperationId)
  ).data;

  return operation.operationId
      == data.createOperationId
    && operation.operationType
      == "CREATE_REQUEST"
    && operation.operationStatus
      == "COMPLETED"
    && operation.adjustmentId
      == adjustmentId
    && operation.productId
      == data.productId
    && operation.actualCountedQuantity
      == data.actualCountedQuantity
    && operation.quantityDifference
      == data.quantityDifference
    && operation.adjustmentDirection
      == data.adjustmentDirection
    && operation.reason == data.reason
    && operation.referenceNumber
      == data.referenceNumber
    && operation.countDate
      == data.countDate
    && operation.countDateKey
      == data.countDateKey
    && operation.remarks
      == data.remarks
    && operation.performedBy
      == request.auth.uid
    && operation.performedByName
      == data.requestedByName
    && operation.createdBy
      == request.auth.uid
    && operation.createdAt
      == request.time;
}

function isValidNewStockAdjustmentRequest(
  data,
  adjustmentId
) {
  return canCreateStockAdjustmentRequest()
    && isValidStockAdjustmentId(
      adjustmentId
    )
    && data.keys().hasOnly([
      "adjustmentId",
      "createOperationId",
      "status",
      "productId",
      "productName",
      "productSku",
      "systemQuantityAtRequest",
      "actualCountedQuantity",
      "quantityDifference",
      "adjustmentDirection",
      "unitCostAtRequest",
      "estimatedAdjustmentValue",
      "reason",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "requestedBy",
      "requestedByName",
      "createdBy",
      "createdAt",
      "updatedAt",
      "barcode",
      "category",
      "categoryCode",
      "unitCode",
      "unitName",
      "unitAbbreviation"
    ])
    && data.keys().hasAll([
      "adjustmentId",
      "createOperationId",
      "status",
      "productId",
      "productName",
      "productSku",
      "systemQuantityAtRequest",
      "actualCountedQuantity",
      "quantityDifference",
      "adjustmentDirection",
      "unitCostAtRequest",
      "estimatedAdjustmentValue",
      "reason",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "requestedBy",
      "requestedByName",
      "createdBy",
      "createdAt",
      "updatedAt"
    ])
    && data.adjustmentId == adjustmentId
    && isValidStockAdjustmentOperationId(
      data.createOperationId
    )
    && data.createOperationId.matches(
      "^stockadj_create_[A-Za-z0-9_-]+$"
    )
    && data.status == "SUBMITTED"
    && data.productId is string
    && data.productId.size() >= 1
    && data.productId.size() <= 128
    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150
    && data.productSku is string
    && data.productSku.size() >= 1
    && data.productSku.size() <= 50
    && stockAdjustmentDifferenceMatches(
      data.systemQuantityAtRequest,
      data.actualCountedQuantity,
      data.quantityDifference,
      data.adjustmentDirection
    )
    && stockAdjustmentReasonMatchesDirection(
      data.reason,
      data.adjustmentDirection
    )
    && data.unitCostAtRequest is number
    && data.unitCostAtRequest >= 0
    && data.unitCostAtRequest <= 999999999
    && isValidStockAdjustmentMoney(
      data.estimatedAdjustmentValue
    )
    && (
      (
        data.quantityDifference > 0
        && data.estimatedAdjustmentValue
          >= data.quantityDifference
            * data.unitCostAtRequest - 0.01
        && data.estimatedAdjustmentValue
          <= data.quantityDifference
            * data.unitCostAtRequest + 0.01
      )
      ||
      (
        data.quantityDifference < 0
        && data.estimatedAdjustmentValue
          >= (0 - data.quantityDifference)
            * data.unitCostAtRequest - 0.01
        && data.estimatedAdjustmentValue
          <= (0 - data.quantityDifference)
            * data.unitCostAtRequest + 0.01
      )
    )
    && data.referenceNumber is string
    && data.referenceNumber.size() <= 100
    && isValidStockAdjustmentCountDate(
      data.countDate,
      data.countDateKey
    )
    && data.remarks is string
    && data.remarks.size() <= 500
    && data.requestedBy
      == request.auth.uid
    && data.requestedByName is string
    && data.requestedByName.size() >= 1
    && data.requestedByName.size() <= 150
    && data.createdBy
      == request.auth.uid
    && data.createdAt == request.time
    && data.updatedAt == request.time
    && hasValidStockAdjustmentOptionalSnapshots(
      data
    )
    && stockAdjustmentRequestMatchesProduct(
      data
    )
    && stockAdjustmentCreateOperationMatchesRequest(
      data,
      adjustmentId
    );
}

function stockAdjustmentPostLinkedDocumentsMatch(
  data,
  adjustmentId
) {
  let product = getAfter(
    /databases/$(database)/documents/products/$(data.productId)
  ).data;

  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(data.movementId)
  ).data;

  let operation = getAfter(
    /databases/$(database)/documents/stockAdjustmentOperations/$(data.postedOperationId)
  ).data;

  return data.postedOperationId
      == data.movementId
    && product.quantity
      == data.postedNewQuantity
    && product.lastStockMovementId
      == data.movementId
    && product.lastStockMovementReason
      == "STOCK_ADJUSTMENT"
    && product.lastStockMovementBy
      == request.auth.uid
    && movement.movementId
      == data.movementId
    && movement.operationId
      == data.postedOperationId
    && movement.adjustmentId
      == adjustmentId
    && movement.productId
      == data.productId
    && movement.productName
      == data.productName
    && movement.productSku
      == data.productSku
    && movement.quantityDifference
      == data.quantityDifference
    && movement.previousQuantity
      == data.postedPreviousQuantity
    && movement.newQuantity
      == data.postedNewQuantity
    && movement.unitCost
      == data.postedUnitCost
    && movement.totalCost
      == data.postedTotalValue
    && movement.approvedBy
      == request.auth.uid
    && movement.createdBy
      == request.auth.uid
    && movement.createdAt
      == request.time
    && operation.operationId
      == data.postedOperationId
    && operation.operationType
      == "POST_ADJUSTMENT"
    && operation.operationStatus
      == "COMPLETED"
    && operation.adjustmentId
      == adjustmentId
    && operation.movementId
      == data.movementId
    && operation.productId
      == data.productId
    && operation.previousQuantity
      == data.postedPreviousQuantity
    && operation.newQuantity
      == data.postedNewQuantity
    && operation.quantityDifference
      == data.quantityDifference
    && operation.unitCost
      == data.postedUnitCost
    && operation.totalCost
      == data.postedTotalValue
    && operation.performedBy
      == request.auth.uid
    && operation.createdBy
      == request.auth.uid
    && operation.createdAt
      == request.time;
}

function isValidPostedStockAdjustmentRequest(
  adjustmentId
) {
  return canReviewStockAdjustmentRequest()
    && resource.data.status
      == "SUBMITTED"
    && request.resource.data.status
      == "POSTED"
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "approvedBy",
        "approvedByName",
        "approvedAt",
        "postedOperationId",
        "movementId",
        "postedPreviousQuantity",
        "postedNewQuantity",
        "postedUnitCost",
        "postedTotalValue",
        "postedAt",
        "updatedAt"
      ])
    && request.resource.data.approvedBy
      == request.auth.uid
    && request.resource.data.approvedByName
      is string
    && request.resource.data.approvedByName.size()
      >= 1
    && request.resource.data.approvedByName.size()
      <= 150
    && request.resource.data.approvedAt
      == request.time
    && isValidStockAdjustmentOperationId(
      request.resource.data.postedOperationId
    )
    && request.resource.data.postedOperationId.matches(
      "^stockadj_post_[A-Za-z0-9_-]+$"
    )
    && request.resource.data.movementId
      == request.resource.data.postedOperationId
    && request.resource.data.postedPreviousQuantity
      is int
    && request.resource.data.postedPreviousQuantity
      >= 0
    && request.resource.data.postedNewQuantity
      == request.resource.data.postedPreviousQuantity
        + resource.data.quantityDifference
    && request.resource.data.postedNewQuantity
      >= 0
    && request.resource.data.postedNewQuantity
      <= 999999999
    && request.resource.data.postedUnitCost
      is number
    && request.resource.data.postedUnitCost
      >= 0
    && (
      (
        resource.data.quantityDifference > 0
        && stockAdjustmentValueMatches(
          resource.data.quantityDifference,
          request.resource.data.postedUnitCost,
          request.resource.data.postedTotalValue
        )
      )
      ||
      (
        resource.data.quantityDifference < 0
        && stockAdjustmentValueMatches(
          0 - resource.data.quantityDifference,
          request.resource.data.postedUnitCost,
          request.resource.data.postedTotalValue
        )
      )
    )
    && request.resource.data.postedAt
      == request.time
    && request.resource.data.updatedAt
      == request.time
    && (
      currentUserProfile().role
        == "SUPERADMIN"
      || resource.data.requestedBy
        != request.auth.uid
    )
    && stockAdjustmentPostLinkedDocumentsMatch(
      request.resource.data,
      adjustmentId
    );
}

function stockAdjustmentDecisionOperationMatches(
  data,
  adjustmentId,
  operationId,
  operationType,
  decisionReason
) {
  let operation = getAfter(
    /databases/$(database)/documents/stockAdjustmentOperations/$(operationId)
  ).data;

  return operation.operationId
      == operationId
    && operation.operationType
      == operationType
    && operation.operationStatus
      == "COMPLETED"
    && operation.adjustmentId
      == adjustmentId
    && operation.productId
      == data.productId
    && operation.decisionReason
      == decisionReason
    && operation.performedBy
      == request.auth.uid
    && operation.createdBy
      == request.auth.uid
    && operation.createdAt
      == request.time;
}

function isValidRejectedStockAdjustmentRequest(
  adjustmentId
) {
  return canReviewStockAdjustmentRequest()
    && resource.data.status
      == "SUBMITTED"
    && request.resource.data.status
      == "REJECTED"
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "rejectedBy",
        "rejectedByName",
        "rejectedAt",
        "rejectionReason",
        "rejectedOperationId",
        "updatedAt"
      ])
    && request.resource.data.rejectedBy
      == request.auth.uid
    && request.resource.data.rejectedByName
      is string
    && request.resource.data.rejectedByName.size()
      >= 1
    && request.resource.data.rejectedByName.size()
      <= 150
    && request.resource.data.rejectedAt
      == request.time
    && request.resource.data.rejectionReason
      is string
    && request.resource.data.rejectionReason.size()
      >= 1
    && request.resource.data.rejectionReason.size()
      <= 500
    && isValidStockAdjustmentOperationId(
      request.resource.data.rejectedOperationId
    )
    && request.resource.data.rejectedOperationId.matches(
      "^stockadj_reject_[A-Za-z0-9_-]+$"
    )
    && request.resource.data.updatedAt
      == request.time
    && stockAdjustmentDecisionOperationMatches(
      request.resource.data,
      adjustmentId,
      request.resource.data.rejectedOperationId,
      "REJECT_REQUEST",
      request.resource.data.rejectionReason
    );
}

function isValidCancelledStockAdjustmentRequest(
  adjustmentId
) {
  return canReviewStockAdjustmentRequest()
    && resource.data.status
      == "SUBMITTED"
    && request.resource.data.status
      == "CANCELLED"
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "cancelledBy",
        "cancelledByName",
        "cancelledAt",
        "cancellationReason",
        "cancelledOperationId",
        "updatedAt"
      ])
    && request.resource.data.cancelledBy
      == request.auth.uid
    && request.resource.data.cancelledByName
      is string
    && request.resource.data.cancelledByName.size()
      >= 1
    && request.resource.data.cancelledByName.size()
      <= 150
    && request.resource.data.cancelledAt
      == request.time
    && request.resource.data.cancellationReason
      is string
    && request.resource.data.cancellationReason.size()
      >= 1
    && request.resource.data.cancellationReason.size()
      <= 500
    && isValidStockAdjustmentOperationId(
      request.resource.data.cancelledOperationId
    )
    && request.resource.data.cancelledOperationId.matches(
      "^stockadj_cancel_[A-Za-z0-9_-]+$"
    )
    && request.resource.data.updatedAt
      == request.time
    && stockAdjustmentDecisionOperationMatches(
      request.resource.data,
      adjustmentId,
      request.resource.data.cancelledOperationId,
      "CANCEL_REQUEST",
      request.resource.data.cancellationReason
    );
}

function isValidStockAdjustmentProductUpdate(
  productId
) {
  let operationId =
    request.resource.data.lastStockMovementId;

  let operation = getAfter(
    /databases/$(database)/documents/stockAdjustmentOperations/$(operationId)
  ).data;

  let adjustment = getAfter(
    /databases/$(database)/documents/stockAdjustmentRequests/$(operation.adjustmentId)
  ).data;

  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(operationId)
  ).data;

  return canReviewStockAdjustmentRequest()
    && resource.data.get(
      "status",
      "ACTIVE"
    ) == "ACTIVE"
    && hasValidProductStockAuditUpdate()
    && request.resource.data.lastStockMovementReason
      == "STOCK_ADJUSTMENT"
    && isValidStockAdjustmentOperationId(
      operationId
    )
    && operationId.matches(
      "^stockadj_post_[A-Za-z0-9_-]+$"
    )
    && request.resource.data.get(
      "costPrice",
      0
    ) == resource.data.get(
      "costPrice",
      0
    )
    && request.resource.data.quantity
      == resource.data.quantity
        + adjustment.quantityDifference
    && request.resource.data.lastStockMovementType
      == adjustment.adjustmentDirection
    && stockAdjustmentAbsoluteQuantityMatches(
      request.resource.data.lastStockMovementQuantity,
      adjustment.quantityDifference
    )
    && request.resource.data.lastStockMovementUnitCost
      == resource.data.get(
        "costPrice",
        0
      )
    && request.resource.data.lastStockMovementBy
      == request.auth.uid
    && adjustment.status == "POSTED"
    && adjustment.productId == productId
    && adjustment.postedOperationId
      == operationId
    && adjustment.movementId
      == operationId
    && adjustment.postedPreviousQuantity
      == resource.data.quantity
    && adjustment.postedNewQuantity
      == request.resource.data.quantity
    && movement.adjustmentId
      == adjustment.adjustmentId
    && movement.productId == productId
    && movement.previousQuantity
      == resource.data.quantity
    && movement.newQuantity
      == request.resource.data.quantity
    && movement.quantityDifference
      == adjustment.quantityDifference
    && operation.operationId
      == operationId
    && operation.operationType
      == "POST_ADJUSTMENT"
    && operation.adjustmentId
      == adjustment.adjustmentId
    && operation.productId == productId;
}

function isValidStockAdjustmentMovement(
  data,
  movementId
) {
  let adjustment = getAfter(
    /databases/$(database)/documents/stockAdjustmentRequests/$(data.adjustmentId)
  ).data;

  let product = getAfter(
    /databases/$(database)/documents/products/$(data.productId)
  ).data;

  let operation = getAfter(
    /databases/$(database)/documents/stockAdjustmentOperations/$(movementId)
  ).data;

  return canReviewStockAdjustmentRequest()
    && isValidStockAdjustmentOperationId(
      movementId
    )
    && movementId.matches(
      "^stockadj_post_[A-Za-z0-9_-]+$"
    )
    && data.keys().hasOnly([
      "movementId",
      "operationId",
      "adjustmentId",
      "movementType",
      "reason",
      "adjustmentReason",
      "adjustmentDirection",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "quantityDifference",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "requestedBy",
      "requestedByName",
      "approvedBy",
      "approvedByName",
      "createdBy",
      "createdAt",
      "barcode",
      "category",
      "categoryCode",
      "unitCode",
      "unitName",
      "unitAbbreviation"
    ])
    && data.keys().hasAll([
      "movementId",
      "operationId",
      "adjustmentId",
      "movementType",
      "reason",
      "adjustmentReason",
      "adjustmentDirection",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "quantityDifference",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "requestedBy",
      "requestedByName",
      "approvedBy",
      "approvedByName",
      "createdBy",
      "createdAt"
    ])
    && data.movementId == movementId
    && data.operationId == movementId
    && isValidStockAdjustmentId(
      data.adjustmentId
    )
    && data.reason
      == "STOCK_ADJUSTMENT"
    && data.adjustmentReason
      == adjustment.reason
    && data.adjustmentDirection
      == adjustment.adjustmentDirection
    && data.movementType
      == adjustment.adjustmentDirection
    && data.productId
      == adjustment.productId
    && data.productName
      == adjustment.productName
    && data.productSku
      == adjustment.productSku
    && data.quantityDifference
      == adjustment.quantityDifference
    && stockAdjustmentAbsoluteQuantityMatches(
      data.quantity,
      data.quantityDifference
    )
    && data.previousQuantity
      == adjustment.postedPreviousQuantity
    && data.newQuantity
      == adjustment.postedNewQuantity
    && data.newQuantity
      == data.previousQuantity
        + data.quantityDifference
    && stockAdjustmentValueMatches(
      data.quantity,
      data.unitCost,
      data.totalCost
    )
    && data.unitCost
      == adjustment.postedUnitCost
    && data.totalCost
      == adjustment.postedTotalValue
    && data.referenceNumber
      == adjustment.referenceNumber
    && data.countDate
      == adjustment.countDate
    && data.countDateKey
      == adjustment.countDateKey
    && data.remarks
      == adjustment.remarks
    && data.requestedBy
      == adjustment.requestedBy
    && data.requestedByName
      == adjustment.requestedByName
    && data.approvedBy
      == request.auth.uid
    && data.approvedByName
      == adjustment.approvedByName
    && data.createdBy
      == request.auth.uid
    && data.createdAt
      == request.time
    && product.quantity
      == data.newQuantity
    && product.lastStockMovementId
      == movementId
    && operation.operationId
      == movementId
    && operation.adjustmentId
      == data.adjustmentId
    && operation.movementId
      == movementId
    && hasValidStockAdjustmentOptionalSnapshots(
      data
    );
}

function isValidStockAdjustmentCreateOperation(
  data,
  operationId
) {
  let adjustment = getAfter(
    /databases/$(database)/documents/stockAdjustmentRequests/$(data.adjustmentId)
  ).data;

  return canCreateStockAdjustmentRequest()
    && isValidStockAdjustmentOperationId(
      operationId
    )
    && operationId.matches(
      "^stockadj_create_[A-Za-z0-9_-]+$"
    )
    && data.keys().hasOnly([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "productId",
      "actualCountedQuantity",
      "quantityDifference",
      "adjustmentDirection",
      "reason",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.keys().hasAll([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "productId",
      "actualCountedQuantity",
      "quantityDifference",
      "adjustmentDirection",
      "reason",
      "referenceNumber",
      "countDate",
      "countDateKey",
      "remarks",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.operationId == operationId
    && data.operationType
      == "CREATE_REQUEST"
    && data.operationStatus
      == "COMPLETED"
    && adjustment.adjustmentId
      == data.adjustmentId
    && adjustment.createOperationId
      == operationId
    && adjustment.productId
      == data.productId
    && adjustment.actualCountedQuantity
      == data.actualCountedQuantity
    && adjustment.quantityDifference
      == data.quantityDifference
    && adjustment.adjustmentDirection
      == data.adjustmentDirection
    && adjustment.reason == data.reason
    && adjustment.referenceNumber
      == data.referenceNumber
    && adjustment.countDate
      == data.countDate
    && adjustment.countDateKey
      == data.countDateKey
    && adjustment.remarks
      == data.remarks
    && data.performedBy
      == request.auth.uid
    && data.performedByName
      == adjustment.requestedByName
    && data.createdBy
      == request.auth.uid
    && data.createdAt
      == request.time;
}

function isValidStockAdjustmentPostOperation(
  data,
  operationId
) {
  let adjustment = getAfter(
    /databases/$(database)/documents/stockAdjustmentRequests/$(data.adjustmentId)
  ).data;

  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(operationId)
  ).data;

  let product = getAfter(
    /databases/$(database)/documents/products/$(data.productId)
  ).data;

  return canReviewStockAdjustmentRequest()
    && isValidStockAdjustmentOperationId(
      operationId
    )
    && operationId.matches(
      "^stockadj_post_[A-Za-z0-9_-]+$"
    )
    && data.keys().hasOnly([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "movementId",
      "productId",
      "previousQuantity",
      "newQuantity",
      "quantity",
      "quantityDifference",
      "adjustmentDirection",
      "unitCost",
      "totalCost",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.keys().hasAll([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "movementId",
      "productId",
      "previousQuantity",
      "newQuantity",
      "quantity",
      "quantityDifference",
      "adjustmentDirection",
      "unitCost",
      "totalCost",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.operationId == operationId
    && data.operationType
      == "POST_ADJUSTMENT"
    && data.operationStatus
      == "COMPLETED"
    && data.movementId == operationId
    && adjustment.status == "POSTED"
    && adjustment.adjustmentId
      == data.adjustmentId
    && adjustment.postedOperationId
      == operationId
    && adjustment.movementId
      == operationId
    && adjustment.productId
      == data.productId
    && adjustment.postedPreviousQuantity
      == data.previousQuantity
    && adjustment.postedNewQuantity
      == data.newQuantity
    && adjustment.quantityDifference
      == data.quantityDifference
    && adjustment.adjustmentDirection
      == data.adjustmentDirection
    && stockAdjustmentAbsoluteQuantityMatches(
      data.quantity,
      data.quantityDifference
    )
    && data.newQuantity
      == data.previousQuantity
        + data.quantityDifference
    && data.unitCost
      == adjustment.postedUnitCost
    && data.totalCost
      == adjustment.postedTotalValue
    && data.performedBy
      == request.auth.uid
    && data.performedByName
      == adjustment.approvedByName
    && data.createdBy
      == request.auth.uid
    && data.createdAt
      == request.time
    && movement.operationId
      == operationId
    && movement.adjustmentId
      == data.adjustmentId
    && product.quantity
      == data.newQuantity;
}

function isValidStockAdjustmentDecisionOperation(
  data,
  operationId
) {
  let adjustment = getAfter(
    /databases/$(database)/documents/stockAdjustmentRequests/$(data.adjustmentId)
  ).data;

  return canReviewStockAdjustmentRequest()
    && isValidStockAdjustmentOperationId(
      operationId
    )
    && data.keys().hasOnly([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "productId",
      "decisionReason",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.keys().hasAll([
      "operationId",
      "operationType",
      "operationStatus",
      "adjustmentId",
      "productId",
      "decisionReason",
      "performedBy",
      "performedByName",
      "createdBy",
      "createdAt"
    ])
    && data.operationId == operationId
    && data.operationStatus
      == "COMPLETED"
    && data.operationType in [
      "REJECT_REQUEST",
      "CANCEL_REQUEST"
    ]
    && data.decisionReason is string
    && data.decisionReason.size() >= 1
    && data.decisionReason.size() <= 500
    && data.productId
      == adjustment.productId
    && data.performedBy
      == request.auth.uid
    && data.createdBy
      == request.auth.uid
    && data.createdAt
      == request.time
    && (
      (
        data.operationType
          == "REJECT_REQUEST"
        && operationId.matches(
          "^stockadj_reject_[A-Za-z0-9_-]+$"
        )
        && adjustment.status
          == "REJECTED"
        && adjustment.rejectedOperationId
          == operationId
        && adjustment.rejectionReason
          == data.decisionReason
      )
      ||
      (
        data.operationType
          == "CANCEL_REQUEST"
        && operationId.matches(
          "^stockadj_cancel_[A-Za-z0-9_-]+$"
        )
        && adjustment.status
          == "CANCELLED"
        && adjustment.cancelledOperationId
          == operationId
        && adjustment.cancellationReason
          == data.decisionReason
      )
    );
}

/*
 * PRODUCT STOCK-WRITE ROUTING
 *
 * These small helpers keep valid Stock In, Stock Out,
 * Purchase Receipt, and Stock Adjustment transactions
 * below Firestore's Rules expression limit.
 */

function isManualStockInReason(value) {
  return value in [
    "MANUAL_STOCK_IN",
    "RETURNED_STOCK",
    "OPENING_BALANCE",
    "OTHER"
  ];
}

function isProductStockMutation() {
  return request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasAny([
      "quantity",
      "costPrice",
      "hasStockHistory",
      "stockMovementCount",
      "lastStockMovementId",
      "lastStockMovementType",
      "lastStockMovementReason",
      "lastStockMovementQuantity",
      "lastStockMovementUnitCost",
      "lastStockMovementAt",
      "lastStockMovementBy"
    ]);
}

function isValidManualStockInProductUpdate(
  productId
) {
  return hasValidProductStockAuditUpdate()
    && isValidProductStockIncreaseBase()
    && request.resource.data.lastStockMovementType
      == "IN"
    && isManualStockInReason(
      request.resource.data.lastStockMovementReason
    )
    && manualStockInProductMatchesMovementAndOperation(
      productId
    );
}

function isValidPurchaseReceiptProductUpdate() {
  return hasValidProductStockAuditUpdate()
    && isValidProductStockIncreaseBase()
    && request.resource.data.lastStockMovementType
      == "IN"
    && request.resource.data.lastStockMovementReason
      == "PURCHASE_RECEIPT";
}

function isValidManualStockOutProductUpdate(
  productId
) {
  return resource.data.get(
      "status",
      "ACTIVE"
    ) == "ACTIVE"
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "quantity",
        "stockStatus",
        "hasStockHistory",
        "stockMovementCount",
        "lastStockMovementId",
        "lastStockMovementType",
        "lastStockMovementReason",
        "lastStockMovementQuantity",
        "lastStockMovementUnitCost",
        "lastStockMovementAt",
        "lastStockMovementBy",
        "updatedBy",
        "updatedAt"
      ])
    && request.resource.data.quantity is int
    && request.resource.data.quantity >= 0
    && request.resource.data.quantity
      == resource.data.quantity
        - request.resource.data.lastStockMovementQuantity
    && request.resource.data.hasStockHistory == true
    && request.resource.data.stockMovementCount is int
    && request.resource.data.stockMovementCount
      == resource.data.get(
        "stockMovementCount",
        0
      ) + 1
    && isValidStockOutOperationId(
      request.resource.data.lastStockMovementId
    )
    && request.resource.data.lastStockMovementType
      == "OUT"
    && isValidStockOutReason(
      request.resource.data.lastStockMovementReason
    )
    && request.resource.data.lastStockMovementQuantity
      is int
    && request.resource.data.lastStockMovementQuantity
      >= 1
    && request.resource.data.lastStockMovementUnitCost
      is number
    && request.resource.data.lastStockMovementUnitCost
      >= 0
    && request.resource.data.lastStockMovementUnitCost
      == resource.data.get(
        "costPrice",
        0
      )
    && request.resource.data.get(
      "costPrice",
      0
    ) == resource.data.get(
      "costPrice",
      0
    )
    && request.resource.data.lastStockMovementAt
      == request.time
    && request.resource.data.get(
      "lastStockMovementBy",
      request.auth.uid
    ) == request.auth.uid
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time
    && hasValidProductStockStatus(
      request.resource.data
    )
    && stockOutProductMatchesMovementAndOperation(
      productId
    );
}


function isValidProductStockUpdate(
  productId
) {
  return hasValidProductStockAuditUpdate()
    && (
      (
        isValidProductStockIncreaseBase()
        && request.resource.data.lastStockMovementReason
          == "PURCHASE_RECEIPT"
      )
      ||
      (
        isValidProductStockIncreaseBase()
        && request.resource.data.lastStockMovementReason in [
          "MANUAL_STOCK_IN",
          "RETURNED_STOCK",
          "OPENING_BALANCE",
          "OTHER"
        ]
        && manualStockInProductMatchesMovementAndOperation(
          productId
        )
      )
      ||
      (
        isValidStockAdjustmentProductUpdate(
          productId
        )
      )
      ||
      (
        resource.data.get(
          "status",
          "ACTIVE"
        ) == "ACTIVE"
        && request.resource.data.lastStockMovementType
          == "OUT"
        && isValidStockOutOperationId(
          request.resource.data.lastStockMovementId
        )
        && isValidStockOutReason(
          request.resource.data.lastStockMovementReason
        )
        && request.resource.data.quantity
          == resource.data.quantity
            - request.resource.data.lastStockMovementQuantity
        && request.resource.data.quantity >= 0
        && resource.data.get(
          "costPrice",
          0
        ) is number
        && resource.data.get(
          "costPrice",
          0
        ) >= 0
        && resource.data.get(
          "costPrice",
          0
        ) <= 999999999
        && request.resource.data.lastStockMovementUnitCost
          == resource.data.get(
            "costPrice",
            0
          )
        && request.resource.data.get(
          "costPrice",
          0
        ) == resource.data.get(
          "costPrice",
          0
        )
        && stockOutProductMatchesMovementAndOperation(
          productId
        )
      )
    );
}

match /products/{productId} {
  allow get, list: if canReadProducts();

  allow create: if canManageProducts()
    && isValidNewProduct(
      request.resource.data,
      productId
    );

  /*
   * Route Stock Adjustment writes first.
   *
   * This avoids evaluating every unrelated
   * Product validator before the adjustment
   * validator and keeps evaluation below the
   * Firestore 1000-expression limit.
   */
  /*
   * Route stock mutations by movement type and reason.
   *
   * Master-data updates never evaluate the large stock
   * validators, while valid stock writes evaluate only
   * their own validator.
   */
  allow update: if canManageProducts()
    && (
      (
        request.resource.data.get(
          "lastStockMovementReason",
          ""
        ) == "STOCK_ADJUSTMENT"
        && isValidStockAdjustmentProductUpdate(
          productId
        )
      )
      ||
      (
        request.resource.data.get(
          "lastStockMovementType",
          ""
        ) == "OUT"
        && isValidManualStockOutProductUpdate(
          productId
        )
      )
      ||
      (
        request.resource.data.get(
          "lastStockMovementType",
          ""
        ) == "IN"
        && request.resource.data.get(
          "lastStockMovementReason",
          ""
        ) == "PURCHASE_RECEIPT"
        && isValidPurchaseReceiptProductUpdate()
      )
      ||
      (
        request.resource.data.get(
          "lastStockMovementType",
          ""
        ) == "IN"
        && isManualStockInReason(
          request.resource.data.get(
            "lastStockMovementReason",
            ""
          )
        )
        && isValidManualStockInProductUpdate(
          productId
        )
      )
      ||
      (
        !isProductStockMutation()
        && (
          isValidProductMasterUpdate()
          || isValidProductUnitAssignment()
          || isValidProductSourceAssignment(
            productId
          )
          || isValidProductMigrationUpdate()
        )
      )
    );

  allow delete: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])
    && resource.data.quantity == 0
    && resource.data.get(
      "hasStockHistory",
      false
    ) == false
    && resource.data.get(
      "stockMovementCount",
      0
    ) == 0
    && resource.data.get(
      "sourceProductId",
      ""
    ) == "";
}

/*
 * PRODUCT MASTER SOURCE RESERVATIONS
 *
 * Prevents the same product-master record from
 * being added more than once.
 */
match /productMasterReservations/{sourceProductId} {

  allow get: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);

  /*
   * The application checks one specific
   * reservation document. Listing every
   * reservation is unnecessary.
   */
  allow list: if false;

  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN",
      "INVENTORY_STAFF"
    ])

    && request.resource.data.keys().hasOnly([
      "sourceProductId",
      "productId",
      "sku",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.keys().hasAll([
      "sourceProductId",
      "productId",
      "sku",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.sourceProductId
      == sourceProductId

    && request.resource.data.sourceProductId
      is string

    && request.resource.data.sourceProductId.size()
      >= 1

    && request.resource.data.sourceProductId.size()
      <= 100

    && request.resource.data.sourceProductId.matches(
      "^[A-Za-z0-9_-]+$"
    )

    && request.resource.data.productId
      is string

    && request.resource.data.productId.size()
      >= 1

    && request.resource.data.productId.size()
      <= 128

    && request.resource.data.sku
      is string

    && request.resource.data.sku.size()
      >= 2

    && request.resource.data.sku.size()
      <= 50

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && getAfter(
      /databases/$(database)/documents/products/$(request.resource.data.productId)
    ).data.sourceProductId == sourceProductId

    && getAfter(
      /databases/$(database)/documents/products/$(request.resource.data.productId)
    ).data.sku == request.resource.data.sku;

  /*
   * Reservations are permanent.
   */
  allow update, delete: if false;
}





    /*
     * BARCODE COUNTERS
     */
    match /barcodeCounters/{barcodePrefix} {
  allow get: if canManageProducts();
  allow list: if false;

  allow create: if canManageProducts()
    && request.resource.data.keys().hasOnly([
      "category",
      "categoryCode",
      "barcodePrefix",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])
    && request.resource.data.keys().hasAll([
      "category",
      "categoryCode",
      "barcodePrefix",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])
    && request.resource.data.barcodePrefix
      == barcodePrefix
    && request.resource.data.categoryCode.matches(
      "^[A-Z0-9_]{2,50}$"
    )
    && request.resource.data.category is string
    && request.resource.data.category.size() >= 2
    && request.resource.data.category.size() <= 150
    && request.resource.data.barcodePrefix.matches(
      "^[0-9]{2}$"
    )
    && request.resource.data.lastSequence == 1
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time
    && get(
      /databases/$(database)/documents/categories/$(request.resource.data.categoryCode)
    ).data.status == "ACTIVE"
    && get(
      /databases/$(database)/documents/categories/$(request.resource.data.categoryCode)
    ).data.name == request.resource.data.category
    && get(
      /databases/$(database)/documents/categories/$(request.resource.data.categoryCode)
    ).data.barcodePrefix
      == request.resource.data.barcodePrefix;

  allow update: if canManageProducts()
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "lastSequence",
        "updatedBy",
        "updatedAt"
      ])
    && request.resource.data.category
      == resource.data.category
    && request.resource.data.categoryCode
      == resource.data.categoryCode
    && request.resource.data.barcodePrefix
      == resource.data.barcodePrefix
    && request.resource.data.lastSequence is int
    && request.resource.data.lastSequence
      == resource.data.lastSequence + 1
    && request.resource.data.lastSequence
      <= 999999999
    && request.resource.data.updatedBy
      == request.auth.uid
    && request.resource.data.updatedAt
      == request.time;

  allow delete: if false;
}

    /*
     * STOCK MOVEMENT HISTORY
     */
    /*
 * STOCK MOVEMENT VALIDATION
 */
function hasValidStockMovementSnapshots(data) {
  return (
      !data.keys().hasAny([
        "barcode"
      ])
      || (
        data.barcode is string
        && data.barcode.size() <= 100
      )
    )
    && (
      !data.keys().hasAny([
        "category"
      ])
      || (
        data.category is string
        && data.category.size() <= 150
      )
    )
    && (
      !data.keys().hasAny([
        "categoryCode"
      ])
      || (
        data.categoryCode is string
        && data.categoryCode.size() <= 50
      )
    )
    && (
      !data.keys().hasAny([
        "unitCode"
      ])
      || (
        data.unitCode is string
        && data.unitCode.size() <= 50
      )
    )
    && (
      !data.keys().hasAny([
        "unitName"
      ])
      || (
        data.unitName is string
        && data.unitName.size() <= 100
      )
    )
    && (
      !data.keys().hasAny([
        "unitAbbreviation"
      ])
      || (
        data.unitAbbreviation is string
        && data.unitAbbreviation.size() <= 10
      )
    )
    && (
      !data.keys().hasAny([
        "remarks"
      ])
      || (
        data.remarks is string
        && data.remarks.size() <= 500
      )
    );
}

function stockInOperationMatchesMovement(
  data,
  movementId
) {
  let operation = getAfter(
    /databases/$(database)/documents/stockInOperations/$(movementId)
  ).data;

  return operation.operationId == movementId
    && operation.status == "COMPLETED"
    && operation.movementId == movementId
    && operation.productId == data.productId
    && operation.productName == data.productName
    && operation.productSku == data.productSku
    && operation.quantityReceived == data.quantity
    && operation.previousQuantity
      == data.previousQuantity
    && operation.newQuantity == data.newQuantity
    && operation.unitCost == data.unitCost
    && operation.totalCost == data.totalCost
    && operation.source == data.source
    && operation.referenceNumber
      == data.referenceNumber
    && operation.dateReceived == data.dateReceived
    && operation.reason == data.reason
    && operation.remarks
      == data.get(
        "remarks",
        ""
      )
    && operation.receivedBy == request.auth.uid
    && operation.receivedByName
      == data.receivedByName
    && operation.createdBy == request.auth.uid
    && operation.createdAt == request.time;
}

function isValidManualStockInMovement(data, movementId) {
  return data.keys().hasOnly([
      "movementId",
      "operationId",
      "movementType",
      "reason",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt",
      "barcode",
      "category",
      "categoryCode",
      "unitCode",
      "unitName",
      "unitAbbreviation",
      "remarks"
    ])
    && data.keys().hasAll([
      "movementId",
      "operationId",
      "movementType",
      "reason",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt"
    ])
    && data.movementId == movementId
    && data.operationId == movementId
    && data.operationId.matches(
      "^[A-Za-z0-9_-]{16,128}$"
    )
    && data.movementType == "IN"
    && data.reason in [
      "MANUAL_STOCK_IN",
      "RETURNED_STOCK",
      "OPENING_BALANCE",
      "OTHER"
    ]
    && data.productId is string
    && data.productId.size() >= 1
    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150
    && data.productSku is string
    && data.productSku.size() >= 2
    && data.productSku.size() <= 50
    && data.quantity is int
    && data.quantity >= 1
    && data.quantity <= 999999999
    && data.previousQuantity is int
    && data.previousQuantity >= 0
    && data.newQuantity
      == data.previousQuantity + data.quantity
    && data.unitCost is number
    && data.unitCost >= 0
    && data.unitCost <= 999999999
    && data.totalCost is number
    && data.totalCost <= 999999999999.99
    && data.totalCost >= data.quantity * data.unitCost - 0.01
    && data.totalCost <= data.quantity * data.unitCost + 0.01
    && data.source is string
    && data.source.size() >= 1
    && data.source.size() <= 150
    && data.referenceNumber is string
    && data.referenceNumber.size() <= 100
    && data.dateReceived is timestamp
    && data.receivedBy == request.auth.uid
    && data.receivedByName is string
    && data.receivedByName.size() >= 1
    && data.receivedByName.size() <= 150
    && data.createdBy == request.auth.uid
    && data.createdAt == request.time
    && hasValidStockMovementSnapshots(data)
    && stockInOperationMatchesMovement(
      data,
      movementId
    );
}

function isValidPurchaseReceiptMovement(data, movementId) {
  return data.keys().hasOnly([
      "movementId",
      "movementType",
      "reason",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "receivedBy",
      "receivedByName",
      "purchaseOrderId",
      "poNumber",
      "goodsReceiptId",
      "goodsReceiptNumber",
      "createdBy",
      "createdAt",
      "barcode",
      "category",
      "categoryCode",
      "unitCode",
      "unitName",
      "unitAbbreviation",
      "remarks"
    ])
    && data.keys().hasAll([
      "movementId",
      "movementType",
      "reason",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "receivedBy",
      "receivedByName",
      "purchaseOrderId",
      "poNumber",
      "goodsReceiptId",
      "goodsReceiptNumber",
      "createdBy",
      "createdAt"
    ])
    && data.movementId == movementId
    && data.movementId.matches(
      "^[A-Za-z0-9_-]{1,128}$"
    )
    && data.movementType == "IN"
    && data.reason == "PURCHASE_RECEIPT"
    && data.productId is string
    && data.productId.size() >= 1
    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150
    && data.productSku is string
    && data.productSku.size() >= 2
    && data.productSku.size() <= 50
    && data.quantity is int
    && data.quantity >= 1
    && data.quantity <= 999999999
    && data.previousQuantity is int
    && data.previousQuantity >= 0
    && data.newQuantity
      == data.previousQuantity + data.quantity
    && data.unitCost is number
    && data.unitCost >= 0
    && data.unitCost <= 999999999
    && data.totalCost is number
    && data.totalCost <= 999999999999.99
    && data.totalCost >= data.quantity * data.unitCost - 0.01
    && data.totalCost <= data.quantity * data.unitCost + 0.01
    && data.source is string
    && data.source.size() >= 1
    && data.source.size() <= 150
    && data.referenceNumber is string
    && data.referenceNumber.size() >= 1
    && data.referenceNumber.size() <= 100
    && data.dateReceived is timestamp
    && data.receivedBy == request.auth.uid
    && data.receivedByName is string
    && data.receivedByName.size() >= 1
    && data.receivedByName.size() <= 150
    && data.purchaseOrderId is string
    && data.purchaseOrderId.size() >= 1
    && data.poNumber.matches(
      "^PO-[0-9]{4}-[0-9]{6}$"
    )
    && data.goodsReceiptId is string
    && data.goodsReceiptId.size() >= 1
    && data.goodsReceiptNumber.matches(
      "^GRN-[0-9]{4}-[0-9]{6}$"
    )
    && data.createdBy == request.auth.uid
    && data.createdAt == request.time
    && hasValidStockMovementSnapshots(data);
}

function stockOutOperationMatchesMovement(
  data,
  movementId
) {
  let operation = getAfter(
    /databases/$(database)/documents/stockOutOperations/$(movementId)
  ).data;

  return operation.operationId == movementId
    && operation.status == "COMPLETED"
    && operation.movementId == movementId
    && operation.productId == data.productId
    && operation.productName == data.productName
    && operation.productSku == data.productSku
    && operation.quantityReleased == data.quantity
    && operation.previousQuantity == data.previousQuantity
    && operation.newQuantity == data.newQuantity
    && operation.unitCost == data.unitCost
    && operation.totalCost == data.totalCost
    && operation.destination == data.destination
    && operation.referenceNumber == data.referenceNumber
    && operation.dateReleased == data.dateReleased
    && operation.reason == data.reason
    && operation.remarks
      == data.get(
        "remarks",
        ""
      )
    && operation.releasedBy == request.auth.uid
    && operation.releasedByName == data.releasedByName
    && operation.createdBy == request.auth.uid
    && operation.createdAt == request.time;
}


function isValidManualStockOutMovement(
  data,
  movementId
) {
  return data.keys().hasOnly([
      "movementId",
      "operationId",
      "movementType",
      "reason",
      "productId",
      "productName",
      "productSku",
      "quantity",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "destination",
      "referenceNumber",
      "dateReleased",
      "releasedBy",
      "releasedByName",
      "createdBy",
      "createdAt",
      "barcode",
      "category",
      "categoryCode",
      "unitCode",
      "unitName",
      "unitAbbreviation",
      "remarks"
    ])
    && data.movementId == movementId
    && data.operationId == movementId
    && isValidStockOutOperationId(
      movementId
    )
    && data.movementType == "OUT"
    && isValidStockOutReason(
      data.reason
    )
    && data.productId is string
    && data.productId.size() >= 1
    && data.productId.size() <= 128
    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150
    && data.productSku is string
    && data.productSku.size() >= 2
    && data.productSku.size() <= 50
    && data.quantity is int
    && data.quantity >= 1
    && data.previousQuantity is int
    && data.previousQuantity >= data.quantity
    && data.newQuantity
      == data.previousQuantity - data.quantity
    && data.unitCost is number
    && data.unitCost >= 0
    && data.totalCost is number
    && data.totalCost
      >= data.quantity * data.unitCost - 0.01
    && data.totalCost
      <= data.quantity * data.unitCost + 0.01
    && isValidStockOutDestinationValue(
      data.destination,
      data.reason
    )
    && data.referenceNumber is string
    && data.referenceNumber.size() <= 100
    && data.dateReleased is timestamp
    && data.dateReleased <= request.time
    && data.releasedBy == request.auth.uid
    && data.releasedByName is string
    && data.releasedByName.size() >= 1
    && data.releasedByName.size() <= 150
    && data.createdBy == request.auth.uid
    && data.createdAt == request.time
    && stockOutOperationMatchesMovement(
      data,
      movementId
    );
}


match /stockMovements/{movementId} {
  allow get, list: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);

  /*
   * Route by movement reason before evaluating
   * the large movement validators.
   */
  /*
   * Route each movement to exactly one large validator.
   */
  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN",
      "INVENTORY_STAFF"
    ])
    && (
      (
        request.resource.data.get(
          "reason",
          ""
        ) == "STOCK_ADJUSTMENT"
        && isValidStockAdjustmentMovement(
          request.resource.data,
          movementId
        )
      )
      ||
      (
        request.resource.data.get(
          "movementType",
          ""
        ) == "OUT"
        && isValidStockOutReason(
          request.resource.data.get(
            "reason",
            ""
          )
        )
        && isValidManualStockOutMovement(
          request.resource.data,
          movementId
        )
      )
      ||
      (
        request.resource.data.get(
          "movementType",
          ""
        ) == "IN"
        && request.resource.data.get(
          "reason",
          ""
        ) == "PURCHASE_RECEIPT"
        && isValidPurchaseReceiptMovement(
          request.resource.data,
          movementId
        )
      )
      ||
      (
        request.resource.data.get(
          "movementType",
          ""
        ) == "IN"
        && isManualStockInReason(
          request.resource.data.get(
            "reason",
            ""
          )
        )
        && isValidManualStockInMovement(
          request.resource.data,
          movementId
        )
      )
    );

  allow update, delete: if false;
}

function stockInMovementMatchesOperation(
  data,
  operationId
) {
  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(operationId)
  ).data;

  return movement.operationId == operationId
    && movement.movementId == operationId
    && movement.productId == data.productId
    && movement.productName == data.productName
    && movement.productSku == data.productSku
    && movement.quantity == data.quantityReceived
    && movement.previousQuantity == data.previousQuantity
    && movement.newQuantity == data.newQuantity
    && movement.unitCost == data.unitCost
    && movement.totalCost == data.totalCost
    && movement.source == data.source
    && movement.referenceNumber == data.referenceNumber
    && movement.dateReceived == data.dateReceived
    && movement.reason == data.reason
    && movement.get(
      "remarks",
      ""
    ) == data.remarks
    && movement.receivedBy == request.auth.uid
    && movement.receivedByName == data.receivedByName
    && movement.createdBy == request.auth.uid
    && movement.createdAt == request.time;
}

match /stockInOperations/{operationId} {
  allow get: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
  allow list: if false;

  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN",
      "INVENTORY_STAFF"
    ])
    && operationId.matches(
      "^[A-Za-z0-9_-]{16,128}$"
    )
    && request.resource.data.keys().hasOnly([
      "operationId",
      "status",
      "movementId",
      "productId",
      "productName",
      "productSku",
      "quantityReceived",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "dateReceivedKey",
      "reason",
      "remarks",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt"
    ])
    && request.resource.data.keys().hasAll([
      "operationId",
      "status",
      "movementId",
      "productId",
      "productName",
      "productSku",
      "quantityReceived",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "source",
      "referenceNumber",
      "dateReceived",
      "dateReceivedKey",
      "reason",
      "remarks",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt"
    ])
    && request.resource.data.operationId == operationId
    && request.resource.data.status == "COMPLETED"
    && request.resource.data.movementId == operationId
    && request.resource.data.quantityReceived is int
    && request.resource.data.quantityReceived >= 1
    && request.resource.data.previousQuantity is int
    && request.resource.data.previousQuantity >= 0
    && request.resource.data.newQuantity
      == request.resource.data.previousQuantity
        + request.resource.data.quantityReceived
    && request.resource.data.unitCost is number
    && request.resource.data.unitCost >= 0
    && request.resource.data.totalCost is number
    && request.resource.data.totalCost <= 999999999999.99
    && request.resource.data.totalCost
      >= request.resource.data.quantityReceived
        * request.resource.data.unitCost - 0.01
    && request.resource.data.totalCost
      <= request.resource.data.quantityReceived
        * request.resource.data.unitCost + 0.01
    && request.resource.data.source is string
    && request.resource.data.source.size() >= 1
    && request.resource.data.source.size() <= 150
    && request.resource.data.referenceNumber is string
    && request.resource.data.referenceNumber.size() <= 100
    && request.resource.data.dateReceived is timestamp
    && request.resource.data.dateReceivedKey.matches(
      "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    )
    && request.resource.data.reason in [
      "MANUAL_STOCK_IN",
      "RETURNED_STOCK",
      "OPENING_BALANCE",
      "OTHER"
    ]
    && request.resource.data.remarks is string
    && request.resource.data.remarks.size() <= 500
    && request.resource.data.receivedBy
      == request.auth.uid
    && request.resource.data.receivedByName is string
    && request.resource.data.receivedByName.size() >= 1
    && request.resource.data.receivedByName.size() <= 150
    && request.resource.data.createdBy
      == request.auth.uid
    && request.resource.data.createdAt
      == request.time
    && stockInMovementMatchesOperation(
      request.resource.data,
      operationId
    );

  allow update, delete: if false;
}


function stockOutMovementMatchesOperation(
  data,
  operationId
) {
  let movement = getAfter(
    /databases/$(database)/documents/stockMovements/$(operationId)
  ).data;

  let product = getAfter(
    /databases/$(database)/documents/products/$(data.productId)
  ).data;

  return movement.movementId == operationId
    && movement.operationId == operationId
    && movement.movementType == "OUT"
    && movement.productId == data.productId
    && movement.productName == data.productName
    && movement.productSku == data.productSku
    && movement.quantity == data.quantityReleased
    && movement.previousQuantity == data.previousQuantity
    && movement.newQuantity == data.newQuantity
    && movement.unitCost == data.unitCost
    && movement.totalCost == data.totalCost
    && movement.destination == data.destination
    && movement.referenceNumber == data.referenceNumber
    && movement.dateReleased == data.dateReleased
    && movement.reason == data.reason
    && movement.get(
      "remarks",
      ""
    ) == data.remarks
    && movement.releasedBy == request.auth.uid
    && movement.releasedByName == data.releasedByName
    && movement.createdBy == request.auth.uid
    && movement.createdAt == request.time
    && product.get(
      "status",
      "ACTIVE"
    ) == "ACTIVE"
    && product.quantity == data.newQuantity
    && product.name == data.productName
    && product.sku == data.productSku
    && product.get(
      "costPrice",
      0
    ) == data.unitCost
    && product.lastStockMovementId == operationId
    && product.lastStockMovementType == "OUT"
    && product.lastStockMovementReason == data.reason
    && product.lastStockMovementQuantity
      == data.quantityReleased
    && product.lastStockMovementUnitCost == data.unitCost
    && product.updatedBy == request.auth.uid
    && product.updatedAt == request.time;
}


function isValidStockOutOperationCreate(
  data,
  operationId
) {
  return isValidStockOutOperationId(
      operationId
    )
    && data.keys().hasOnly([
      "operationId",
      "status",
      "movementId",
      "productId",
      "productName",
      "productSku",
      "quantityReleased",
      "previousQuantity",
      "newQuantity",
      "unitCost",
      "totalCost",
      "destination",
      "referenceNumber",
      "dateReleased",
      "dateReleasedKey",
      "reason",
      "remarks",
      "releasedBy",
      "releasedByName",
      "createdBy",
      "createdAt"
    ])
    && data.operationId == operationId
    && data.status == "COMPLETED"
    && data.movementId == operationId
    && data.productId is string
    && data.productId.size() >= 1
    && data.productId.size() <= 128
    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150
    && data.productSku is string
    && data.productSku.size() >= 2
    && data.productSku.size() <= 50
    && data.quantityReleased is int
    && data.quantityReleased >= 1
    && data.previousQuantity is int
    && data.previousQuantity >= data.quantityReleased
    && data.newQuantity
      == data.previousQuantity - data.quantityReleased
    && data.unitCost is number
    && data.unitCost >= 0
    && data.totalCost is number
    && data.totalCost
      >= data.quantityReleased * data.unitCost - 0.01
    && data.totalCost
      <= data.quantityReleased * data.unitCost + 0.01
    && isValidStockOutReason(
      data.reason
    )
    && isValidStockOutDestinationValue(
      data.destination,
      data.reason
    )
    && data.referenceNumber is string
    && data.referenceNumber.size() <= 100
    && data.dateReleased is timestamp
    && data.dateReleased <= request.time
    && data.dateReleasedKey is string
    && data.dateReleasedKey.matches(
      "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    )
    && data.remarks is string
    && data.remarks.size() <= 500
    && data.releasedBy == request.auth.uid
    && data.releasedByName is string
    && data.releasedByName.size() >= 1
    && data.releasedByName.size() <= 150
    && data.createdBy == request.auth.uid
    && data.createdAt == request.time
    && stockOutMovementMatchesOperation(
      data,
      operationId
    );
}

match /stockOutOperations/{operationId} {
  allow get: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);

  allow list: if false;

  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN",
      "INVENTORY_STAFF"
    ])
    && isValidStockOutOperationCreate(
      request.resource.data,
      operationId
    );

  allow update, delete: if false;
}


/*
 * STOCK ADJUSTMENT REQUESTS
 */
match /stockAdjustmentRequests/{adjustmentId} {
  allow get, list: if canReadStockAdjustments();

  allow create: if isValidNewStockAdjustmentRequest(
    request.resource.data,
    adjustmentId
  );

  /*
   * Route by requested final status so only one
   * transition validator runs per update.
   */
  allow update: if (
      (
        request.resource.data.status
          == "POSTED"
        && isValidPostedStockAdjustmentRequest(
          adjustmentId
        )
      )
      ||
      (
        request.resource.data.status
          == "REJECTED"
        && isValidRejectedStockAdjustmentRequest(
          adjustmentId
        )
      )
      ||
      (
        request.resource.data.status
          == "CANCELLED"
        && isValidCancelledStockAdjustmentRequest(
          adjustmentId
        )
      )
    );

  allow delete: if false;
}

/*
 * STOCK ADJUSTMENT OPERATIONS
 *
 * Operations are immutable and are loaded by ID.
 * Listing the entire internal collection is denied.
 */
match /stockAdjustmentOperations/{operationId} {
  allow get: if canReadStockAdjustments();
  allow list: if false;

  /*
   * Route by operation type before invoking a
   * cross-document validator.
   */
  allow create: if (
      (
        request.resource.data.operationType
          == "CREATE_REQUEST"
        && isValidStockAdjustmentCreateOperation(
          request.resource.data,
          operationId
        )
      )
      ||
      (
        request.resource.data.operationType
          == "POST_ADJUSTMENT"
        && isValidStockAdjustmentPostOperation(
          request.resource.data,
          operationId
        )
      )
      ||
      (
        request.resource.data.operationType in [
          "REJECT_REQUEST",
          "CANCEL_REQUEST"
        ]
        && isValidStockAdjustmentDecisionOperation(
          request.resource.data,
          operationId
        )
      )
    );

  allow update, delete: if false;
}

    /*
 * CATEGORY MASTER DATA
 */
match /categories/{categoryId} {

  /*
   * These roles may view category records.
   */
  allow get, list: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);

  /*
   * Only Superadmin and Admin may create
   * category records.
   */
  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data.keys().hasOnly([
      "name",
      "code",
      "barcodePrefix",
      "description",
      "status",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "name",
      "code",
      "barcodePrefix",
      "description",
      "status",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100

    && request.resource.data.code is string
    && request.resource.data.code == categoryId
    && request.resource.data.code.size() >= 2
    && request.resource.data.code.size() <= 50
    && request.resource.data.code.matches(
      "^[A-Z0-9_]+$"
    )

    && request.resource.data.barcodePrefix is string
    && request.resource.data.barcodePrefix.matches(
      "^[0-9]{2}$"
    )

    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500

    && request.resource.data.status in [
      "ACTIVE",
      "INACTIVE"
    ]

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Only editable fields may change.
   *
   * Category code and barcode prefix remain
   * permanent after creation.
   */
  allow update: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "name",
        "description",
        "status",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.code
      == resource.data.code

    && request.resource.data.barcodePrefix
      == resource.data.barcodePrefix

    && request.resource.data.createdBy
      == resource.data.createdBy

    && request.resource.data.createdAt
      == resource.data.createdAt

    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100

    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500

    && request.resource.data.status in [
      "ACTIVE",
      "INACTIVE"
    ]

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Categories should be deactivated rather
   * than permanently deleted.
   */
  allow delete: if false;
}


/*
 * CATEGORY BARCODE PREFIX RESERVATIONS
 */
match /categoryBarcodePrefixes/{barcodePrefix} {

  /*
   * The category creation transaction checks
   * whether the selected prefix already exists.
   */
  allow get: if hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);

  allow list: if false;

  /*
   * Reserve a prefix when its category is created.
   */
  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data.keys().hasOnly([
      "barcodePrefix",
      "categoryCode",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.keys().hasAll([
      "barcodePrefix",
      "categoryCode",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.barcodePrefix
      == barcodePrefix

    && request.resource.data.barcodePrefix is string

    && request.resource.data.barcodePrefix.matches(
      "^[0-9]{2}$"
    )

    && request.resource.data.categoryCode is string

    && request.resource.data.categoryCode.matches(
      "^[A-Z0-9_]+$"
    )

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time;

  /*
   * Prefix reservations remain permanent so an
   * existing barcode prefix cannot be reused.
   */
  allow update, delete: if false;
}

/*
 * UNIT OF MEASUREMENT MASTER DATA
 */
match /units/{unitId} {

  /*
   * Inventory Staff and Auditor may view units
   * but cannot manage them.
   */
  allow get, list: if hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);

  /*
   * Only Superadmin and Admin may create units.
   */
  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data.keys().hasOnly([
      "name",
      "code",
      "abbreviation",
      "description",
      "status",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "name",
      "code",
      "abbreviation",
      "description",
      "status",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100

    && request.resource.data.code is string
    && request.resource.data.code == unitId
    && request.resource.data.code.size() >= 2
    && request.resource.data.code.size() <= 50
    && request.resource.data.code.matches(
      "^[A-Z0-9_]+$"
    )

    && request.resource.data.abbreviation is string
    && request.resource.data.abbreviation.matches(
      "^[A-Z0-9]{1,10}$"
    )

    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500

    && request.resource.data.status in [
      "ACTIVE",
      "INACTIVE"
    ]

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && request.resource.data.updatedAt
      == request.time;

  /*
   * The unit code and abbreviation remain
   * permanent after the unit is created.
   */
  allow update: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "name",
        "description",
        "status",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.code
      == resource.data.code

    && request.resource.data.abbreviation
      == resource.data.abbreviation

    && request.resource.data.createdBy
      == resource.data.createdBy

    && request.resource.data.createdAt
      == resource.data.createdAt

    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.name.size() <= 100

    && request.resource.data.description is string
    && request.resource.data.description.size() <= 500

    && request.resource.data.status in [
      "ACTIVE",
      "INACTIVE"
    ]

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Units should be deactivated instead of
   * permanently deleted.
   */
  allow delete: if false;
}


/*
 * UNIT ABBREVIATION RESERVATIONS
 *
 * This collection prevents duplicate unit
 * abbreviations such as two units using PCS.
 */
match /unitAbbreviations/{unitAbbreviation} {

  /*
   * The create-unit transaction checks whether
   * the abbreviation is already reserved.
   */
  allow get: if hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);

  allow list: if false;

  /*
   * Reserve an abbreviation when a unit is
   * created.
   */
  allow create: if hasRole([
      "SUPERADMIN",
      "ADMIN"
    ])

    && request.resource.data.keys().hasOnly([
      "abbreviation",
      "unitCode",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.keys().hasAll([
      "abbreviation",
      "unitCode",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.abbreviation
      == unitAbbreviation

    && request.resource.data.abbreviation
      is string

    && request.resource.data.abbreviation.matches(
      "^[A-Z0-9]{1,10}$"
    )

    && request.resource.data.unitCode
      is string

    && request.resource.data.unitCode.matches(
      "^[A-Z0-9_]+$"
    )

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time;

  /*
   * Abbreviation reservations remain permanent
   * so previously assigned abbreviations cannot
   * be reused.
   */
  allow update, delete: if false;
}


/*
 * Supplier access helpers.
 */
function isSupplierManager() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);
}

function canReadSuppliers() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);
}

function canUpdateSupplierPurchaseHistory() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
}

function isValidSupplierStatus(status) {
  return status in [
    "ACTIVE",
    "INACTIVE"
  ];
}

function isValidSupplierPaymentTerm(paymentTerm) {
  return paymentTerm in [
    "CASH_ON_DELIVERY",
    "PREPAID",
    "NET_7",
    "NET_15",
    "NET_30",
    "NET_45",
    "NET_60",
    "CUSTOM"
  ];
}

function isValidSupplierData(data) {
  return data.supplierCode is string
    && data.supplierCode.matches(
      "^SUP-[0-9]{6}$"
    )

    && data.name is string
    && data.name.size() >= 2
    && data.name.size() <= 150

    && data.nameNormalized is string
    && data.nameNormalized.size() >= 2
    && data.nameNormalized.size() <= 150

    && data.contactPerson is string
    && data.contactPerson.size() <= 100

    && data.contactNumber is string
    && data.contactNumber.size() <= 30
    && data.contactNumber.matches(
      "^[0-9+(). -]*$"
    )

    && data.email is string
    && data.email.size() <= 150
    && (
      data.email == ""
      || data.email.matches(
        "^[^@ ]+@[^@ ]+[.][^@ ]+$"
      )
    )

    && data.address is string
    && data.address.size() <= 300

    && data.tin is string
    && data.tin.size() <= 50
    && data.tin.matches(
      "^[A-Za-z0-9 -]*$"
    )

    && isValidSupplierPaymentTerm(
      data.paymentTerm
    )

    && data.customPaymentTerms is string
    && data.customPaymentTerms.size() <= 100

    && (
      (
        data.paymentTerm == "CUSTOM"
        && data.customPaymentTerms.size() >= 1
      )
      ||
      (
        data.paymentTerm != "CUSTOM"
        && data.customPaymentTerms == ""
      )
    )

    && data.notes is string
    && data.notes.size() <= 500

    && isValidSupplierStatus(
      data.status
    )

    && data.hasPurchaseHistory is bool

    && data.purchaseOrderCount is int
    && data.purchaseOrderCount >= 0

    && data.createdBy is string
    && data.createdBy.size() >= 1

    && data.updatedBy is string
    && data.updatedBy.size() >= 1;
}

function onlySupplierMasterFieldsChanged() {
  return request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "name",
      "nameNormalized",
      "contactPerson",
      "contactNumber",
      "email",
      "address",
      "tin",
      "paymentTerm",
      "customPaymentTerms",
      "notes",
      "updatedBy",
      "updatedAt"
    ]);
}

function onlySupplierStatusFieldsChanged() {
  return request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "status",
      "statusChangedBy",
      "statusChangedAt",
      "updatedBy",
      "updatedAt"
    ]);
}

function onlySupplierPurchaseHistoryFieldsChanged() {
  return request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "hasPurchaseHistory",
      "purchaseOrderCount",
      "lastPurchaseOrderId",
      "lastPurchaseOrderNumber",
      "lastPurchaseOrderSubmittedAt",
      "updatedBy",
      "updatedAt"
    ]);
}

function submittedPurchaseOrderMatchesSupplier(
  supplierId,
  purchaseOrderId,
  poNumber
) {
  let purchaseOrderAfter = getAfter(
    /databases/$(database)/documents/purchaseOrders/$(purchaseOrderId)
  ).data;

  return purchaseOrderAfter.status == "SUBMITTED"
    && purchaseOrderAfter.supplierId == supplierId
    && purchaseOrderAfter.poNumber == poNumber
    && purchaseOrderAfter.submittedBy == request.auth.uid
    && purchaseOrderAfter.submittedAt == request.time;
}

/*
 * SUPPLIER MASTER DATA
 */
match /suppliers/{supplierId} {

  /*
   * Superadmin, Admin, Inventory Staff,
   * and Auditor may view supplier records.
   */
  allow get, list: if canReadSuppliers();

  /*
   * Only Superadmin and Admin may create
   * supplier records.
   */
  allow create: if isSupplierManager()

    && request.resource.data.keys().hasOnly([
      "supplierCode",
      "name",
      "nameNormalized",
      "contactPerson",
      "contactNumber",
      "email",
      "address",
      "tin",
      "paymentTerm",
      "customPaymentTerms",
      "notes",
      "status",
      "hasPurchaseHistory",
      "purchaseOrderCount",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "supplierCode",
      "name",
      "nameNormalized",
      "contactPerson",
      "contactNumber",
      "email",
      "address",
      "tin",
      "paymentTerm",
      "customPaymentTerms",
      "notes",
      "status",
      "hasPurchaseHistory",
      "purchaseOrderCount",
      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && isValidSupplierData(
      request.resource.data
    )

    && request.resource.data.status
      == "ACTIVE"

    && request.resource.data.hasPurchaseHistory
      == false

    && request.resource.data.purchaseOrderCount
      == 0

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && request.resource.data.updatedAt
      == request.time

    /*
     * Supplier creation must also update the
     * supplier number counter in the same batch
     * or transaction.
     */
    && getAfter(
      /databases/$(database)/documents/supplierCounters/default
    ).data.updatedBy == request.auth.uid

    && getAfter(
      /databases/$(database)/documents/supplierCounters/default
    ).data.updatedAt == request.time;

  /*
   * Update supplier contact and payment details.
   */
  allow update: if isValidSupplierData(
      request.resource.data
    )

    && (
      /*
       * Superadmin/Admin supplier master-data
       * and status management.
       */
      (
        isSupplierManager()

        && (
          (
            onlySupplierMasterFieldsChanged()

            && request.resource.data.supplierCode
              == resource.data.supplierCode

            && request.resource.data.status
              == resource.data.status

            && request.resource.data.hasPurchaseHistory
              == resource.data.hasPurchaseHistory

            && request.resource.data.purchaseOrderCount
              == resource.data.purchaseOrderCount

            && request.resource.data.createdBy
              == resource.data.createdBy

            && request.resource.data.createdAt
              == resource.data.createdAt

            && request.resource.data.updatedBy
              == request.auth.uid

            && request.resource.data.updatedAt
              == request.time
          )

          ||

          (
            onlySupplierStatusFieldsChanged()

            && request.resource.data.status
              != resource.data.status

            && request.resource.data.keys().hasAll([
              "statusChangedBy",
              "statusChangedAt"
            ])

            && request.resource.data.statusChangedBy
              == request.auth.uid

            && request.resource.data.statusChangedAt
              == request.time

            && request.resource.data.updatedBy
              == request.auth.uid

            && request.resource.data.updatedAt
              == request.time
          )
        )
      )

      ||

      /*
       * Purchase Order submission updates the
       * supplier's permanent purchase history.
       */
      (
        canUpdateSupplierPurchaseHistory()

        && onlySupplierPurchaseHistoryFieldsChanged()

        && resource.data.status == "ACTIVE"

        && request.resource.data.status == "ACTIVE"

        && request.resource.data.hasPurchaseHistory
          == true

        && request.resource.data.purchaseOrderCount
          == resource.data.purchaseOrderCount + 1

        && request.resource.data.lastPurchaseOrderId
          is string

        && request.resource.data.lastPurchaseOrderId.size()
          >= 1

        && request.resource.data.lastPurchaseOrderNumber
          is string

        && request.resource.data.lastPurchaseOrderNumber.matches(
          "^PO-[0-9]{4}-[0-9]{6}$"
        )

        && request.resource.data.lastPurchaseOrderSubmittedAt
          == request.time

        && request.resource.data.updatedBy
          == request.auth.uid

        && request.resource.data.updatedAt
          == request.time

        && submittedPurchaseOrderMatchesSupplier(
          supplierId,
          request.resource.data.lastPurchaseOrderId,
          request.resource.data.lastPurchaseOrderNumber
        )
      )
    );

  /*
   * Supplier records remain permanent.
   */
  allow delete: if false;
}

/*
 * SUPPLIER CODE COUNTER
 */
match /supplierCounters/{counterId} {

  /*
   * The create-supplier transaction reads the
   * current supplier sequence.
   */
  allow get: if isSupplierManager();

  allow list: if false;

  /*
   * The first supplier begins at sequence 1.
   */
  allow create: if isSupplierManager()

    && counterId == "default"

    && request.resource.data.keys().hasOnly([
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.lastSequence
      is int

    && request.resource.data.lastSequence
      == 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Every new supplier increases the counter
   * by exactly one.
   */
  allow update: if isSupplierManager()

    && counterId == "default"

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "lastSequence",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.lastSequence
      is int

    && request.resource.data.lastSequence
      == resource.data.lastSequence + 1

    && request.resource.data.lastSequence
      <= 999999

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  allow delete: if false;
}

/*
 * PURCHASE ORDER ACCESS
 */
function canReadPurchaseOrders() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);
}

function canManagePurchaseOrderDrafts() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
}

function isPurchaseOrderApprover() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN"
  ]);
}

function isValidPurchaseOrderStatus(status) {
  return status in [
    "DRAFT",
    "SUBMITTED",
    "APPROVED",
    "PARTIALLY_RECEIVED",
    "RECEIVED",
    "CANCELLED"
  ];
}

function supplierHistoryUpdatedForSubmission(
  purchaseOrderId,
  supplierId,
  poNumber
) {
  let supplierBefore = get(
    /databases/$(database)/documents/suppliers/$(supplierId)
  ).data;

  let supplierAfter = getAfter(
    /databases/$(database)/documents/suppliers/$(supplierId)
  ).data;

  return supplierBefore.status == "ACTIVE"
    && supplierAfter.status == "ACTIVE"
    && supplierAfter.hasPurchaseHistory == true
    && supplierAfter.purchaseOrderCount
      == supplierBefore.purchaseOrderCount + 1
    && supplierAfter.lastPurchaseOrderId
      == purchaseOrderId
    && supplierAfter.lastPurchaseOrderNumber
      == poNumber
    && supplierAfter.lastPurchaseOrderSubmittedAt
      == request.time
    && supplierAfter.updatedBy
      == request.auth.uid
    && supplierAfter.updatedAt
      == request.time;
}


/*
 * GOODS RECEIVING ACCESS
 */
function canReadGoodsReceipts() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF",
    "AUDITOR"
  ]);
}

function canPostGoodsReceipts() {
  return hasRole([
    "SUPERADMIN",
    "ADMIN",
    "INVENTORY_STAFF"
  ]);
}

function isValidGoodsReceiptDateKey(value) {
  return value is string
    && value.matches(
      "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    );
}

function isValidGoodsReceiptMoney(value) {
  return value is number
    && value >= 0
    && value <= 999999999999.99;
}

/*
 * Confirms that a receiving PO update points to
 * the Goods Receipt created in the same atomic
 * transaction.
 *
 * This performs one shared getAfter() call for the
 * PO header operation. Item rules intentionally use
 * local validation so large receipts do not exceed
 * Firestore rule document-access limits.
 */
function goodsReceiptMatchesPurchaseOrderUpdate(
  purchaseOrderId
) {
  let receiptAfter = getAfter(
    /databases/$(database)/documents/goodsReceipts/$(request.resource.data.lastGoodsReceiptId)
  ).data;

  return receiptAfter.purchaseOrderId
      == purchaseOrderId
    && receiptAfter.poNumber
      == resource.data.poNumber
    && receiptAfter.supplierId
      == resource.data.supplierId
    && receiptAfter.goodsReceiptNumber
      == request.resource.data.lastGoodsReceiptNumber
    && receiptAfter.referenceNumber
      == request.resource.data.lastGoodsReceiptReference
    && receiptAfter.purchaseOrderStatusBefore
      == resource.data.status
    && receiptAfter.purchaseOrderStatusAfter
      == request.resource.data.status
    && receiptAfter.totalReceivedQuantity
      == request.resource.data.totalReceivedQuantity
        - resource.data.totalReceivedQuantity
    && receiptAfter.createdBy
      == request.auth.uid
    && receiptAfter.createdAt
      == request.time;
}

/*
 * Confirms that the receipt header and its parent PO
 * move together in the same atomic transaction.
 */
function purchaseOrderMatchesGoodsReceiptCreate(
  data,
  goodsReceiptId
) {
  let purchaseOrderBefore = get(
    /databases/$(database)/documents/purchaseOrders/$(data.purchaseOrderId)
  ).data;

  let purchaseOrderAfter = getAfter(
    /databases/$(database)/documents/purchaseOrders/$(data.purchaseOrderId)
  ).data;

  return purchaseOrderBefore.poNumber
      == data.poNumber
    && purchaseOrderAfter.poNumber
      == data.poNumber
    && purchaseOrderBefore.supplierId
      == data.supplierId
    && purchaseOrderAfter.supplierId
      == data.supplierId
    && purchaseOrderBefore.status
      == data.purchaseOrderStatusBefore
    && purchaseOrderAfter.status
      == data.purchaseOrderStatusAfter
    && purchaseOrderAfter.totalReceivedQuantity
      == purchaseOrderBefore.totalReceivedQuantity
        + data.totalReceivedQuantity
    && purchaseOrderAfter.goodsReceiptCount
      == purchaseOrderBefore.goodsReceiptCount + 1
    && purchaseOrderAfter.hasReceivingHistory
      == true
    && purchaseOrderAfter.lastGoodsReceiptId
      == goodsReceiptId
    && purchaseOrderAfter.lastGoodsReceiptNumber
      == data.goodsReceiptNumber
    && purchaseOrderAfter.lastGoodsReceiptReference
      == data.referenceNumber
    && purchaseOrderAfter.lastReceivedAt
      == request.time
    && purchaseOrderAfter.updatedBy
      == request.auth.uid
    && purchaseOrderAfter.updatedAt
      == request.time;
}

function reservationMatchesGoodsReceipt(data) {
  let receiptAfter = getAfter(
    /databases/$(database)/documents/goodsReceipts/$(data.goodsReceiptId)
  ).data;

  return receiptAfter.goodsReceiptNumber
      == data.goodsReceiptNumber
    && receiptAfter.purchaseOrderId
      == data.purchaseOrderId
    && receiptAfter.poNumber
      == data.poNumber
    && receiptAfter.supplierId
      == data.supplierId
    && receiptAfter.referenceNumber
      == data.referenceNumber
    && receiptAfter.createdBy
      == request.auth.uid
    && receiptAfter.createdAt
      == request.time;
}

function isValidPurchaseOrderPaymentTerm(paymentTerm) {
  return paymentTerm in [
    "CASH_ON_DELIVERY",
    "PREPAID",
    "NET_7",
    "NET_15",
    "NET_30",
    "NET_45",
    "NET_60",
    "CUSTOM"
  ];
}

function isValidPurchaseOrderDateKey(value) {
  return value is string
    && value.matches(
      "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    );
}

function isValidOptionalPurchaseOrderDateKey(value) {
  return value is string
    && (
      value == ""
      || value.matches(
        "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      )
    );
}

function isValidPurchaseOrderMoney(value) {
  return value is number
    && value >= 0
    && value <= 999999999999.99;
}

function purchaseOrderCounterMatchesCreate(data) {
  let counter = getAfter(
    /databases/$(database)/documents/purchaseOrderCounters/$(string(data.poYear))
  ).data;

  return data.poSequence is int
    && data.poSequence >= 1
    && data.poSequence <= 999999
    && int(data.poNumber[3:7]) == data.poYear
    && int(data.poNumber[8:14]) == data.poSequence
    && counter.year == data.poYear
    && counter.lastSequence == data.poSequence
    && counter.updatedBy == request.auth.uid
    && counter.updatedAt == request.time;
}

function isValidPurchaseOrderHeader(data) {
  return data.keys().hasOnly([
      "poNumber",
      "poYear",
      "poSequence",

      "supplierId",
      "supplierCode",
      "supplierName",
      "supplierAddress",
      "supplierTin",
      "supplierPaymentTerm",
      "supplierCustomPaymentTerms",

      "orderDate",
      "orderDateKey",
      "expectedDeliveryDate",
      "expectedDeliveryDateKey",

      "status",

      "itemCount",
      "itemProductIds",

      "totalOrderedQuantity",
      "totalReceivedQuantity",

      "subtotal",
      "discountAmount",
      "taxAmount",
      "shippingAmount",
      "grandTotal",

      "hasReceivingHistory",
      "goodsReceiptCount",

      "notes",
      "revision",

      "submittedBy",
      "submittedByName",
      "submittedAt",

      "approvedBy",
      "approvedByName",
      "approvedAt",

      "cancellationReason",
      "cancelledBy",
      "cancelledByName",
      "cancelledAt",

      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && data.keys().hasAll([
      "poNumber",
      "poYear",

      "supplierId",
      "supplierCode",
      "supplierName",
      "supplierAddress",
      "supplierTin",
      "supplierPaymentTerm",
      "supplierCustomPaymentTerms",

      "orderDate",
      "orderDateKey",
      "expectedDeliveryDate",
      "expectedDeliveryDateKey",

      "status",

      "itemCount",
      "itemProductIds",

      "totalOrderedQuantity",
      "totalReceivedQuantity",

      "subtotal",
      "discountAmount",
      "taxAmount",
      "shippingAmount",
      "grandTotal",

      "hasReceivingHistory",
      "goodsReceiptCount",

      "notes",
      "revision",

      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && data.poNumber is string
    && data.poNumber.matches(
      "^PO-[0-9]{4}-[0-9]{6}$"
    )

    && data.poYear is int
    && data.poYear >= 2000
    && data.poYear <= 9999

    && (
      !data.keys().hasAny([
        "poSequence"
      ])
      || (
        data.poSequence is int
        && data.poSequence >= 1
        && data.poSequence <= 999999
      )
    )

    && data.supplierId is string
    && data.supplierId.size() >= 1

    && data.supplierCode is string
    && data.supplierCode.size() >= 1
    && data.supplierCode.size() <= 30

    && data.supplierName is string
    && data.supplierName.size() >= 2
    && data.supplierName.size() <= 150

    && data.supplierAddress is string
    && data.supplierAddress.size() <= 300

    && data.supplierTin is string
    && data.supplierTin.size() <= 50

    && isValidPurchaseOrderPaymentTerm(
      data.supplierPaymentTerm
    )

    && data.supplierCustomPaymentTerms is string
    && data.supplierCustomPaymentTerms.size() <= 100

    && data.orderDate is timestamp

    && isValidPurchaseOrderDateKey(
      data.orderDateKey
    )

    && (
      data.expectedDeliveryDate == null
      || data.expectedDeliveryDate is timestamp
    )

    && isValidOptionalPurchaseOrderDateKey(
      data.expectedDeliveryDateKey
    )

    && (
      data.expectedDeliveryDateKey == ""
      || data.expectedDeliveryDateKey
        >= data.orderDateKey
    )

    && isValidPurchaseOrderStatus(
      data.status
    )

    && data.itemCount is int
    && data.itemCount >= 1
    && data.itemCount <= 100

    && data.itemProductIds is list
    && data.itemProductIds.size()
      == data.itemCount

    && data.totalOrderedQuantity is int
    && data.totalOrderedQuantity >= 1

    && data.totalReceivedQuantity is int
    && data.totalReceivedQuantity == 0

    && isValidPurchaseOrderMoney(
      data.subtotal
    )

    && isValidPurchaseOrderMoney(
      data.discountAmount
    )

    && data.discountAmount
      <= data.subtotal

    && isValidPurchaseOrderMoney(
      data.taxAmount
    )

    && isValidPurchaseOrderMoney(
      data.shippingAmount
    )

    && isValidPurchaseOrderMoney(
      data.grandTotal
    )

    && data.grandTotal
      >= (
        data.subtotal
        - data.discountAmount
        + data.taxAmount
        + data.shippingAmount
        - 0.01
      )

    && data.grandTotal
      <= (
        data.subtotal
        - data.discountAmount
        + data.taxAmount
        + data.shippingAmount
        + 0.01
      )

    && data.hasReceivingHistory is bool
    && data.hasReceivingHistory == false

    && data.goodsReceiptCount is int
    && data.goodsReceiptCount == 0

    && data.notes is string
    && data.notes.size() <= 1000

    && data.revision is int
    && data.revision >= 1

    && data.createdBy is string
    && data.createdBy.size() >= 1

    && data.createdAt is timestamp

    && data.updatedBy is string
    && data.updatedBy.size() >= 1

    && data.updatedAt is timestamp

    /*
     * Validate the selected supplier snapshot.
     */
    && exists(
      /databases/$(database)/documents/suppliers/$(data.supplierId)
    )

    && get(
      /databases/$(database)/documents/suppliers/$(data.supplierId)
    ).data.status == "ACTIVE"

    && data.supplierCode
      == get(
        /databases/$(database)/documents/suppliers/$(data.supplierId)
      ).data.supplierCode

    && data.supplierName
      == get(
        /databases/$(database)/documents/suppliers/$(data.supplierId)
      ).data.name;
}

function isValidPurchaseOrderItem(
  data,
  purchaseOrderId,
  itemId
) {
  return data.keys().hasOnly([
      "purchaseOrderId",
      "poNumber",
      "poStatus",

      "productId",
      "productName",
      "productSku",
      "barcode",

      "category",
      "categoryCode",

      "unitCode",
      "unitName",
      "unitAbbreviation",

      "orderedQuantity",
      "receivedQuantity",
      "remainingQuantity",

      "unitCost",
      "lineTotal",

      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && data.keys().hasAll([
      "purchaseOrderId",
      "poNumber",
      "poStatus",

      "productId",
      "productName",
      "productSku",
      "barcode",

      "category",
      "categoryCode",

      "unitCode",
      "unitName",
      "unitAbbreviation",

      "orderedQuantity",
      "receivedQuantity",
      "remainingQuantity",

      "unitCost",
      "lineTotal",

      "createdBy",
      "createdAt",
      "updatedBy",
      "updatedAt"
    ])

    && data.purchaseOrderId
      == purchaseOrderId

    && data.productId
      == itemId

    && data.poNumber is string
    && data.poNumber.matches(
      "^PO-[0-9]{4}-[0-9]{6}$"
    )

    && isValidPurchaseOrderStatus(
      data.poStatus
    )

    && data.productName is string
    && data.productName.size() >= 1
    && data.productName.size() <= 150

    && data.productSku is string
    && data.productSku.size() >= 2
    && data.productSku.size() <= 50

    && data.barcode is string
    && data.barcode.size() <= 100

    && data.category is string
    && data.category.size() >= 1
    && data.category.size() <= 150

    && data.categoryCode is string
    && data.categoryCode.size() >= 1
    && data.categoryCode.size() <= 50

    && data.unitCode is string
    && data.unitCode.size() >= 1
    && data.unitCode.size() <= 50

    && data.unitName is string
    && data.unitName.size() >= 1
    && data.unitName.size() <= 100

    && data.unitAbbreviation is string
    && data.unitAbbreviation.size() >= 1
    && data.unitAbbreviation.size() <= 10

    && data.orderedQuantity is int
    && data.orderedQuantity >= 1
    && data.orderedQuantity <= 999999999

    && data.receivedQuantity is int
    && data.receivedQuantity == 0

    && data.remainingQuantity is int
    && data.remainingQuantity
      == data.orderedQuantity

    && data.unitCost is number
    && data.unitCost >= 0
    && data.unitCost <= 999999999

    && isValidPurchaseOrderMoney(
      data.lineTotal
    )

    && data.lineTotal
      >= (
        data.orderedQuantity
        * data.unitCost
        - 0.01
      )

    && data.lineTotal
      <= (
        data.orderedQuantity
        * data.unitCost
        + 0.01
      )

    && data.createdBy is string
    && data.createdBy.size() >= 1

    && data.createdAt is timestamp

    && data.updatedBy is string
    && data.updatedBy.size() >= 1

    && data.updatedAt is timestamp;
}


/*
 * PURCHASE ORDER HEADERS
 */
match /purchaseOrders/{purchaseOrderId} {

  allow get, list: if canReadPurchaseOrders();

  /*
   * Create a new Draft Purchase Order.
   */
  allow create: if canManagePurchaseOrderDrafts()

    && request.resource.data.status == "DRAFT"

    && isValidPurchaseOrderHeader(
      request.resource.data
    )

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time

    && request.resource.data.revision
      == 1

    && request.resource.data.keys().hasAll([
      "poSequence"
    ])

    && purchaseOrderCounterMatchesCreate(
      request.resource.data
    )

    && !request.resource.data.keys().hasAny([
      "submittedBy",
      "submittedByName",
      "submittedAt",
      "approvedBy",
      "approvedByName",
      "approvedAt",
      "cancellationReason",
      "cancelledBy",
      "cancelledByName",
      "cancelledAt"
    ]);

  /*
   * Only Draft Purchase Orders may be edited.
   */
  allow update: if canManagePurchaseOrderDrafts()

    && resource.data.status
      == "DRAFT"

    && request.resource.data.status
      == "DRAFT"

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "supplierId",
        "supplierCode",
        "supplierName",
        "supplierAddress",
        "supplierTin",
        "supplierPaymentTerm",
        "supplierCustomPaymentTerms",

        "orderDate",
        "orderDateKey",
        "expectedDeliveryDate",
        "expectedDeliveryDateKey",

        "itemCount",
        "itemProductIds",
        "totalOrderedQuantity",

        "subtotal",
        "discountAmount",
        "taxAmount",
        "shippingAmount",
        "grandTotal",

        "notes",
        "revision",

        "updatedBy",
        "updatedAt"
      ])

    && isValidPurchaseOrderHeader(
      request.resource.data
    )

    /*
     * Permanent Purchase Order fields.
     */
    && request.resource.data.poNumber
      == resource.data.poNumber

    && request.resource.data.poYear
      == resource.data.poYear

    && request.resource.data.get(
      "poSequence",
      0
    ) == resource.data.get(
      "poSequence",
      0
    )

    && request.resource.data.createdBy
      == resource.data.createdBy

    && request.resource.data.createdAt
      == resource.data.createdAt

    && request.resource.data.totalReceivedQuantity
      == resource.data.totalReceivedQuantity

    && request.resource.data.hasReceivingHistory
      == resource.data.hasReceivingHistory

    && request.resource.data.goodsReceiptCount
      == resource.data.goodsReceiptCount

    && request.resource.data.revision
      == resource.data.revision + 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Submit a Draft Purchase Order for approval.
   */
  allow update: if canManagePurchaseOrderDrafts()

    && resource.data.status == "DRAFT"

    && request.resource.data.status == "SUBMITTED"

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "submittedBy",
        "submittedByName",
        "submittedAt",
        "revision",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.submittedBy
      == request.auth.uid

    && request.resource.data.submittedByName
      is string

    && request.resource.data.submittedByName.size()
      >= 1

    && request.resource.data.submittedByName.size()
      <= 150

    && request.resource.data.submittedAt
      == request.time

    && request.resource.data.revision
      == resource.data.revision + 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time

    && supplierHistoryUpdatedForSubmission(
      purchaseOrderId,
      resource.data.supplierId,
      resource.data.poNumber
    );

  /*
   * Approve a Submitted Purchase Order.
   */
  allow update: if isPurchaseOrderApprover()

    && resource.data.status == "SUBMITTED"

    && request.resource.data.status == "APPROVED"

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "approvedBy",
        "approvedByName",
        "approvedAt",
        "revision",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.approvedBy
      == request.auth.uid

    && request.resource.data.approvedByName
      is string

    && request.resource.data.approvedByName.size()
      >= 1

    && request.resource.data.approvedByName.size()
      <= 150

    && request.resource.data.approvedAt
      == request.time

    && request.resource.data.revision
      == resource.data.revision + 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Post a Goods Receipt against an Approved or
   * Partially Received Purchase Order.
   */
  allow update: if canPostGoodsReceipts()

    && resource.data.status in [
      "APPROVED",
      "PARTIALLY_RECEIVED"
    ]

    && request.resource.data.status in [
      "PARTIALLY_RECEIVED",
      "RECEIVED"
    ]

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "totalReceivedQuantity",
        "hasReceivingHistory",
        "goodsReceiptCount",
        "lastGoodsReceiptId",
        "lastGoodsReceiptNumber",
        "lastGoodsReceiptReference",
        "lastReceivedAt",
        "revision",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.totalReceivedQuantity
      is int

    && request.resource.data.totalReceivedQuantity
      > resource.data.totalReceivedQuantity

    && request.resource.data.totalReceivedQuantity
      <= resource.data.totalOrderedQuantity

    && (
      (
        request.resource.data.totalReceivedQuantity
          == resource.data.totalOrderedQuantity
        && request.resource.data.status
          == "RECEIVED"
      )
      ||
      (
        request.resource.data.totalReceivedQuantity
          < resource.data.totalOrderedQuantity
        && request.resource.data.status
          == "PARTIALLY_RECEIVED"
      )
    )

    && request.resource.data.hasReceivingHistory
      == true

    && request.resource.data.goodsReceiptCount
      == resource.data.goodsReceiptCount + 1

    && request.resource.data.lastGoodsReceiptId
      is string

    && request.resource.data.lastGoodsReceiptId.size()
      >= 1

    && request.resource.data.lastGoodsReceiptId.size()
      <= 128

    && request.resource.data.lastGoodsReceiptNumber
      is string

    && request.resource.data.lastGoodsReceiptNumber.matches(
      "^GRN-[0-9]{4}-[0-9]{6}$"
    )

    && request.resource.data.lastGoodsReceiptReference
      is string

    && request.resource.data.lastGoodsReceiptReference.size()
      >= 1

    && request.resource.data.lastGoodsReceiptReference.size()
      <= 100

    && request.resource.data.lastReceivedAt
      == request.time

    && request.resource.data.revision
      == resource.data.revision + 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time

    && goodsReceiptMatchesPurchaseOrderUpdate(
      purchaseOrderId
    );

  /*
   * Cancel a Draft, Submitted, or Approved PO
   * before any goods receiving takes place.
   */
  allow update: if isPurchaseOrderApprover()

    && resource.data.status in [
      "DRAFT",
      "SUBMITTED",
      "APPROVED"
    ]

    && request.resource.data.status == "CANCELLED"

    && resource.data.hasReceivingHistory == false

    && resource.data.totalReceivedQuantity == 0

    && resource.data.goodsReceiptCount == 0

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "cancellationReason",
        "cancelledBy",
        "cancelledByName",
        "cancelledAt",
        "revision",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.cancellationReason
      is string

    && request.resource.data.cancellationReason.size()
      >= 1

    && request.resource.data.cancellationReason.size()
      <= 500

    && request.resource.data.cancelledBy
      == request.auth.uid

    && request.resource.data.cancelledByName
      is string

    && request.resource.data.cancelledByName.size()
      >= 1

    && request.resource.data.cancelledByName.size()
      <= 150

    && request.resource.data.cancelledAt
      == request.time

    && request.resource.data.revision
      == resource.data.revision + 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  /*
   * Purchase Order headers remain permanent.
   */
  allow delete: if false;

  /*
   * PURCHASE ORDER ITEMS
   */
  match /items/{itemId} {

    allow get, list: if canReadPurchaseOrders();

    allow create: if canManagePurchaseOrderDrafts()

      && request.resource.data.poStatus == "DRAFT"

      && isValidPurchaseOrderItem(
        request.resource.data,
        purchaseOrderId,
        itemId
      )

      && request.resource.data.createdBy
        == request.auth.uid

      && request.resource.data.createdAt
        == request.time

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    allow update: if canManagePurchaseOrderDrafts()

      && resource.data.poStatus
        == "DRAFT"

      && request.resource.data.poStatus
        == "DRAFT"

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "productName",
          "productSku",
          "barcode",

          "category",
          "categoryCode",

          "unitCode",
          "unitName",
          "unitAbbreviation",

          "orderedQuantity",
          "remainingQuantity",

          "unitCost",
          "lineTotal",

          "updatedBy",
          "updatedAt"
        ])

      && isValidPurchaseOrderItem(
        request.resource.data,
        purchaseOrderId,
        itemId
      )

      /*
       * Permanent item identifiers.
       */
      && request.resource.data.purchaseOrderId
        == resource.data.purchaseOrderId

      && request.resource.data.poNumber
        == resource.data.poNumber

      && request.resource.data.productId
        == resource.data.productId

      && request.resource.data.receivedQuantity
        == resource.data.receivedQuantity

      && request.resource.data.createdBy
        == resource.data.createdBy

      && request.resource.data.createdAt
        == resource.data.createdAt

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    /*
     * Keep item snapshots synchronized when the
     * parent PO moves through its workflow.
     */
    allow update: if canManagePurchaseOrderDrafts()

      && resource.data.poStatus == "DRAFT"

      && request.resource.data.poStatus == "SUBMITTED"

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "poStatus",
          "updatedBy",
          "updatedAt"
        ])

      && isValidPurchaseOrderItem(
        request.resource.data,
        purchaseOrderId,
        itemId
      )

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    allow update: if isPurchaseOrderApprover()

      && resource.data.poStatus == "SUBMITTED"

      && request.resource.data.poStatus == "APPROVED"

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "poStatus",
          "updatedBy",
          "updatedAt"
        ])

      && isValidPurchaseOrderItem(
        request.resource.data,
        purchaseOrderId,
        itemId
      )

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    allow update: if isPurchaseOrderApprover()

      && resource.data.poStatus in [
        "DRAFT",
        "SUBMITTED",
        "APPROVED"
      ]

      && request.resource.data.poStatus == "CANCELLED"

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "poStatus",
          "updatedBy",
          "updatedAt"
        ])

      && isValidPurchaseOrderItem(
        request.resource.data,
        purchaseOrderId,
        itemId
      )

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    /*
     * Receive quantity against one PO item.
     */
    allow update: if canPostGoodsReceipts()

      && resource.data.poStatus in [
        "APPROVED",
        "PARTIALLY_RECEIVED"
      ]

      && request.resource.data.poStatus in [
        "PARTIALLY_RECEIVED",
        "RECEIVED"
      ]

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "receivedQuantity",
          "remainingQuantity",
          "poStatus",
          "lastReceivedQuantity",
          "lastReceivedUnitCost",
          "lastGoodsReceiptId",
          "lastGoodsReceiptNumber",
          "lastReceivedAt",
          "updatedBy",
          "updatedAt"
        ])

      && request.resource.data.receivedQuantity
        is int

      && request.resource.data.receivedQuantity
        > resource.data.receivedQuantity

      && request.resource.data.receivedQuantity
        <= resource.data.orderedQuantity

      && request.resource.data.remainingQuantity
        is int

      && request.resource.data.remainingQuantity
        == request.resource.data.orderedQuantity
          - request.resource.data.receivedQuantity

      && request.resource.data.lastReceivedQuantity
        is int

      && request.resource.data.lastReceivedQuantity
        == request.resource.data.receivedQuantity
          - resource.data.receivedQuantity

      && request.resource.data.lastReceivedQuantity
        >= 1

      && request.resource.data.lastReceivedQuantity
        <= resource.data.remainingQuantity

      && request.resource.data.lastReceivedUnitCost
        is number

      && request.resource.data.lastReceivedUnitCost
        >= 0

      && request.resource.data.lastReceivedUnitCost
        <= 999999999

      && request.resource.data.lastGoodsReceiptId
        is string

      && request.resource.data.lastGoodsReceiptId.size()
        >= 1

      && request.resource.data.lastGoodsReceiptId.size()
        <= 128

      && request.resource.data.lastGoodsReceiptNumber
        is string

      && request.resource.data.lastGoodsReceiptNumber.matches(
        "^GRN-[0-9]{4}-[0-9]{6}$"
      )

      && request.resource.data.lastReceivedAt
        == request.time

      && (
        request.resource.data.poStatus
          == "PARTIALLY_RECEIVED"
        || request.resource.data.remainingQuantity
          == 0
      )

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    /*
     * Synchronize an unselected PO item's status
     * when the parent PO moves to PARTIALLY_RECEIVED
     * or RECEIVED.
     */
    allow update: if canPostGoodsReceipts()

      && resource.data.poStatus in [
        "APPROVED",
        "PARTIALLY_RECEIVED"
      ]

      && request.resource.data.poStatus in [
        "PARTIALLY_RECEIVED",
        "RECEIVED"
      ]

      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "poStatus",
          "updatedBy",
          "updatedAt"
        ])

      && (
        request.resource.data.poStatus
          == "PARTIALLY_RECEIVED"
        || resource.data.remainingQuantity
          == 0
      )

      && request.resource.data.updatedBy
        == request.auth.uid

      && request.resource.data.updatedAt
        == request.time;

    /*
     * Items may only be removed while Draft.
     */
    allow delete: if canManagePurchaseOrderDrafts()
      && resource.data.poStatus == "DRAFT";
  }
}


/*
 * PURCHASE ORDER NUMBER COUNTERS
 */
match /purchaseOrderCounters/{counterId} {

  allow get: if canManagePurchaseOrderDrafts();

  allow list: if false;

  allow create: if canManagePurchaseOrderDrafts()

    && counterId.matches(
      "^[0-9]{4}$"
    )

    && request.resource.data.keys().hasOnly([
      "year",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "year",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.year is int

    && request.resource.data.year >= 2000

    && request.resource.data.year <= 9999

    && request.resource.data.lastSequence is int

    && request.resource.data.lastSequence
      == 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  allow update: if canManagePurchaseOrderDrafts()

    && counterId.matches(
      "^[0-9]{4}$"
    )

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "year",
        "lastSequence",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.year
      == resource.data.year

    && request.resource.data.lastSequence
      is int

    && request.resource.data.lastSequence
      == resource.data.lastSequence + 1

    && request.resource.data.lastSequence
      <= 999999

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  allow delete: if false;
}




function goodsReceiptCounterMatchesCreate(data) {
  let counter = getAfter(
    /databases/$(database)/documents/goodsReceiptCounters/$(string(data.goodsReceiptYear))
  ).data;

  return data.goodsReceiptSequence is int
    && data.goodsReceiptSequence >= 1
    && data.goodsReceiptSequence <= 999999
    && int(data.goodsReceiptNumber[4:8])
      == data.goodsReceiptYear
    && int(data.goodsReceiptNumber[9:15])
      == data.goodsReceiptSequence
    && counter.year == data.goodsReceiptYear
    && counter.lastSequence
      == data.goodsReceiptSequence
    && counter.updatedBy == request.auth.uid
    && counter.updatedAt == request.time;
}

/*
 * GOODS RECEIPT HEADERS
 */
match /goodsReceipts/{goodsReceiptId} {

  allow get, list: if canReadGoodsReceipts();

  allow create: if canPostGoodsReceipts()

    && request.resource.data.keys().hasOnly([
      "goodsReceiptNumber",
      "goodsReceiptYear",
      "goodsReceiptSequence",
      "purchaseOrderId",
      "poNumber",
      "supplierId",
      "supplierCode",
      "supplierName",
      "referenceNumber",
      "dateReceived",
      "dateReceivedKey",
      "status",
      "itemCount",
      "totalReceivedQuantity",
      "totalValue",
      "remarks",
      "purchaseOrderStatusBefore",
      "purchaseOrderStatusAfter",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.keys().hasAll([
      "goodsReceiptNumber",
      "goodsReceiptYear",
      "goodsReceiptSequence",
      "purchaseOrderId",
      "poNumber",
      "supplierId",
      "supplierCode",
      "supplierName",
      "referenceNumber",
      "dateReceived",
      "dateReceivedKey",
      "status",
      "itemCount",
      "totalReceivedQuantity",
      "totalValue",
      "remarks",
      "purchaseOrderStatusBefore",
      "purchaseOrderStatusAfter",
      "receivedBy",
      "receivedByName",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.goodsReceiptNumber
      is string

    && request.resource.data.goodsReceiptNumber.matches(
      "^GRN-[0-9]{4}-[0-9]{6}$"
    )

    && request.resource.data.goodsReceiptYear
      is int

    && request.resource.data.goodsReceiptYear
      >= 2000

    && request.resource.data.goodsReceiptYear
      <= 9999

    && request.resource.data.goodsReceiptSequence
      is int

    && request.resource.data.goodsReceiptSequence
      >= 1

    && request.resource.data.goodsReceiptSequence
      <= 999999

    && request.resource.data.purchaseOrderId
      is string

    && request.resource.data.purchaseOrderId.size()
      >= 1

    && request.resource.data.purchaseOrderId.size()
      <= 128

    && request.resource.data.poNumber
      is string

    && request.resource.data.poNumber.matches(
      "^PO-[0-9]{4}-[0-9]{6}$"
    )

    && request.resource.data.supplierId
      is string

    && request.resource.data.supplierId.size()
      >= 1

    && request.resource.data.supplierCode
      is string

    && request.resource.data.supplierCode.size()
      >= 1

    && request.resource.data.supplierCode.size()
      <= 30

    && request.resource.data.supplierName
      is string

    && request.resource.data.supplierName.size()
      >= 2

    && request.resource.data.supplierName.size()
      <= 150

    && request.resource.data.referenceNumber
      is string

    && request.resource.data.referenceNumber.size()
      >= 1

    && request.resource.data.referenceNumber.size()
      <= 100

    && request.resource.data.dateReceived
      is timestamp

    && isValidGoodsReceiptDateKey(
      request.resource.data.dateReceivedKey
    )

    && request.resource.data.status
      == "COMPLETED"

    && request.resource.data.itemCount
      is int

    && request.resource.data.itemCount
      >= 1

    && request.resource.data.itemCount
      <= 30

    && request.resource.data.totalReceivedQuantity
      is int

    && request.resource.data.totalReceivedQuantity
      >= 1

    && request.resource.data.totalReceivedQuantity
      <= 999999999

    && isValidGoodsReceiptMoney(
      request.resource.data.totalValue
    )

    && request.resource.data.remarks
      is string

    && request.resource.data.remarks.size()
      <= 500

    && request.resource.data.purchaseOrderStatusBefore in [
      "APPROVED",
      "PARTIALLY_RECEIVED"
    ]

    && request.resource.data.purchaseOrderStatusAfter in [
      "PARTIALLY_RECEIVED",
      "RECEIVED"
    ]

    && request.resource.data.receivedBy
      == request.auth.uid

    && request.resource.data.receivedByName
      is string

    && request.resource.data.receivedByName.size()
      >= 1

    && request.resource.data.receivedByName.size()
      <= 150

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && goodsReceiptCounterMatchesCreate(
      request.resource.data
    )

    && purchaseOrderMatchesGoodsReceiptCreate(
      request.resource.data,
      goodsReceiptId
    );

  allow update, delete: if false;

  /*
   * GOODS RECEIPT ITEMS
   */
  match /items/{itemId} {

    allow get, list: if canReadGoodsReceipts();

    allow create: if canPostGoodsReceipts()

      && request.resource.data.keys().hasOnly([
        "goodsReceiptId",
        "goodsReceiptNumber",
        "purchaseOrderId",
        "poNumber",
        "productId",
        "productName",
        "productSku",
        "category",
        "categoryCode",
        "unitCode",
        "unitName",
        "unitAbbreviation",
        "orderedQuantity",
        "previouslyReceivedQuantity",
        "quantityReceived",
        "remainingQuantity",
        "unitCost",
        "lineTotal",
        "stockMovementId",
        "createdBy",
        "createdAt"
      ])

      && request.resource.data.keys().hasAll([
        "goodsReceiptId",
        "goodsReceiptNumber",
        "purchaseOrderId",
        "poNumber",
        "productId",
        "productName",
        "productSku",
        "category",
        "categoryCode",
        "unitCode",
        "unitName",
        "unitAbbreviation",
        "orderedQuantity",
        "previouslyReceivedQuantity",
        "quantityReceived",
        "remainingQuantity",
        "unitCost",
        "lineTotal",
        "stockMovementId",
        "createdBy",
        "createdAt"
      ])

      && request.resource.data.goodsReceiptId
        == goodsReceiptId

      && request.resource.data.goodsReceiptNumber
        is string

      && request.resource.data.goodsReceiptNumber.matches(
        "^GRN-[0-9]{4}-[0-9]{6}$"
      )

      && request.resource.data.purchaseOrderId
        is string

      && request.resource.data.purchaseOrderId.size()
        >= 1

      && request.resource.data.poNumber
        is string

      && request.resource.data.poNumber.matches(
        "^PO-[0-9]{4}-[0-9]{6}$"
      )

      && request.resource.data.productId
        == itemId

      && request.resource.data.productName
        is string

      && request.resource.data.productName.size()
        >= 1

      && request.resource.data.productName.size()
        <= 150

      && request.resource.data.productSku
        is string

      && request.resource.data.productSku.size()
        >= 2

      && request.resource.data.productSku.size()
        <= 50

      && request.resource.data.category
        is string

      && request.resource.data.category.size()
        >= 1

      && request.resource.data.category.size()
        <= 150

      && request.resource.data.categoryCode
        is string

      && request.resource.data.categoryCode.size()
        >= 1

      && request.resource.data.categoryCode.size()
        <= 50

      && request.resource.data.unitCode
        is string

      && request.resource.data.unitCode.size()
        >= 1

      && request.resource.data.unitCode.size()
        <= 50

      && request.resource.data.unitName
        is string

      && request.resource.data.unitName.size()
        >= 1

      && request.resource.data.unitName.size()
        <= 100

      && request.resource.data.unitAbbreviation
        is string

      && request.resource.data.unitAbbreviation.size()
        >= 1

      && request.resource.data.unitAbbreviation.size()
        <= 10

      && request.resource.data.orderedQuantity
        is int

      && request.resource.data.orderedQuantity
        >= 1

      && request.resource.data.previouslyReceivedQuantity
        is int

      && request.resource.data.previouslyReceivedQuantity
        >= 0

      && request.resource.data.quantityReceived
        is int

      && request.resource.data.quantityReceived
        >= 1

      && request.resource.data.remainingQuantity
        is int

      && request.resource.data.remainingQuantity
        >= 0

      && request.resource.data.previouslyReceivedQuantity
        + request.resource.data.quantityReceived
        + request.resource.data.remainingQuantity
        == request.resource.data.orderedQuantity

      && request.resource.data.unitCost
        is number

      && request.resource.data.unitCost
        >= 0

      && request.resource.data.unitCost
        <= 999999999

      && isValidGoodsReceiptMoney(
        request.resource.data.lineTotal
      )

      && request.resource.data.lineTotal
        >= request.resource.data.quantityReceived
          * request.resource.data.unitCost - 0.01

      && request.resource.data.lineTotal
        <= request.resource.data.quantityReceived
          * request.resource.data.unitCost + 0.01

      && request.resource.data.stockMovementId
        is string

      && request.resource.data.stockMovementId.size()
        >= 1

      && request.resource.data.stockMovementId.size()
        <= 128

      && request.resource.data.createdBy
        == request.auth.uid

      && request.resource.data.createdAt
        == request.time;

    allow update, delete: if false;
  }
}

/*
 * GOODS RECEIPT NUMBER COUNTERS
 */
match /goodsReceiptCounters/{counterId} {

  allow get: if canPostGoodsReceipts();

  allow list: if false;

  allow create: if canPostGoodsReceipts()

    && counterId.matches(
      "^[0-9]{4}$"
    )

    && request.resource.data.keys().hasOnly([
      "year",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.keys().hasAll([
      "year",
      "lastSequence",
      "updatedBy",
      "updatedAt"
    ])

    && request.resource.data.year
      is int

    && request.resource.data.year
      >= 2000

    && request.resource.data.year
      <= 9999

    && request.resource.data.lastSequence
      == 1

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  allow update: if canPostGoodsReceipts()

    && counterId.matches(
      "^[0-9]{4}$"
    )

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "year",
        "lastSequence",
        "updatedBy",
        "updatedAt"
      ])

    && request.resource.data.year
      == resource.data.year

    && request.resource.data.lastSequence
      is int

    && request.resource.data.lastSequence
      == resource.data.lastSequence + 1

    && request.resource.data.lastSequence
      <= 999999

    && request.resource.data.updatedBy
      == request.auth.uid

    && request.resource.data.updatedAt
      == request.time;

  allow delete: if false;
}

/*
 * SUPPLIER REFERENCE RESERVATIONS
 */
match /goodsReceiptReferenceReservations/{reservationId} {

  allow get: if canPostGoodsReceipts();

  allow list: if false;

  allow create: if canPostGoodsReceipts()

    && request.resource.data.keys().hasOnly([
      "supplierId",
      "supplierCode",
      "supplierName",
      "referenceNumber",
      "purchaseOrderId",
      "poNumber",
      "goodsReceiptId",
      "goodsReceiptNumber",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.keys().hasAll([
      "supplierId",
      "supplierCode",
      "supplierName",
      "referenceNumber",
      "purchaseOrderId",
      "poNumber",
      "goodsReceiptId",
      "goodsReceiptNumber",
      "createdBy",
      "createdAt"
    ])

    && request.resource.data.supplierId
      is string

    && request.resource.data.supplierId.size()
      >= 1

    && request.resource.data.supplierCode
      is string

    && request.resource.data.supplierCode.size()
      >= 1

    && request.resource.data.supplierCode.size()
      <= 30

    && request.resource.data.supplierName
      is string

    && request.resource.data.supplierName.size()
      >= 2

    && request.resource.data.supplierName.size()
      <= 150

    && request.resource.data.referenceNumber
      is string

    && request.resource.data.referenceNumber.size()
      >= 1

    && request.resource.data.referenceNumber.size()
      <= 100

    && request.resource.data.purchaseOrderId
      is string

    && request.resource.data.purchaseOrderId.size()
      >= 1

    && request.resource.data.poNumber
      is string

    && request.resource.data.poNumber.matches(
      "^PO-[0-9]{4}-[0-9]{6}$"
    )

    && request.resource.data.goodsReceiptId
      is string

    && request.resource.data.goodsReceiptId.size()
      >= 1

    && request.resource.data.goodsReceiptId.size()
      <= 128

    && request.resource.data.goodsReceiptNumber
      is string

    && request.resource.data.goodsReceiptNumber.matches(
      "^GRN-[0-9]{4}-[0-9]{6}$"
    )

    && request.resource.data.createdBy
      == request.auth.uid

    && request.resource.data.createdAt
      == request.time

    && reservationId
      == hashing.sha256(
        (
          request.resource.data.supplierId
          + "__"
          + request.resource.data.referenceNumber
        ).toUtf8()
      ).toHexString()

    && reservationMatchesGoodsReceipt(
      request.resource.data
    );

  allow update, delete: if false;
}

    /*
     * REPORTING INVENTORY TRANSACTIONS
     *
     * These documents are created together with posted stock changes and
     * become immutable ledger records. Validation is intentionally local to
     * keep multi-document inventory writes below the Rules expression limit.
     */
    match /inventoryTransactions/{transactionId} {
      allow get, list: if hasRole([
        "SUPERADMIN",
        "ADMIN",
        "INVENTORY_STAFF",
        "AUDITOR"
      ]);

      allow create: if hasRole([
          "SUPERADMIN",
          "ADMIN",
          "INVENTORY_STAFF"
        ])
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "referenceNumber",
          "transactionType",
          "productId",
          "sourceProductId",
          "productName",
          "sku",
          "barcode",
          "category",
          "categoryCode",
          "unitCode",
          "unitName",
          "unitAbbreviation",
          "quantityBefore",
          "quantityChanged",
          "quantityAfter",
          "quantityIn",
          "quantityOut",
          "unitCost",
          "totalCost",
          "supplierId",
          "supplierName",
          "relatedDocumentId",
          "relatedDocumentType",
          "reason",
          "remarks",
          "performedBy",
          "performedByName",
          "performedByEmail",
          "performedByRole",
          "approvedBy",
          "approvedByName",
          "approvedByRole",
          "transactionDate",
          "createdAt",
          "updatedAt",
          "metadata"
        ])
        && request.resource.data.keys().hasAll([
          "schemaVersion",
          "referenceNumber",
          "transactionType",
          "productId",
          "productName",
          "sku",
          "quantityBefore",
          "quantityChanged",
          "quantityAfter",
          "quantityIn",
          "quantityOut",
          "performedBy",
          "performedByName",
          "performedByRole",
          "transactionDate",
          "createdAt"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.referenceNumber is string
        && request.resource.data.referenceNumber.size() >= 1
        && request.resource.data.referenceNumber.size() <= 128
        && request.resource.data.transactionType in [
          "OPENING_STOCK",
          "STOCK_IN",
          "STOCK_OUT",
          "GOODS_RECEIPT",
          "ADJUSTMENT_INCREASE",
          "ADJUSTMENT_DECREASE",
          "RETURN_IN",
          "RETURN_OUT",
          "VOID"
        ]
        && request.resource.data.productId is string
        && request.resource.data.productId.size() >= 1
        && request.resource.data.productId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() >= 1
        && request.resource.data.productName.size() <= 150
        && request.resource.data.sku is string
        && request.resource.data.sku.size() >= 1
        && request.resource.data.sku.size() <= 50
        && request.resource.data.quantityBefore is number
        && request.resource.data.quantityBefore >= 0
        && request.resource.data.quantityChanged is number
        && request.resource.data.quantityAfter is number
        && request.resource.data.quantityAfter >= 0
        && request.resource.data.quantityAfter
          == request.resource.data.quantityBefore
            + request.resource.data.quantityChanged
        && request.resource.data.quantityIn is number
        && request.resource.data.quantityIn >= 0
        && request.resource.data.quantityOut is number
        && request.resource.data.quantityOut >= 0
        && (
          (
            request.resource.data.quantityChanged > 0
            && request.resource.data.quantityIn
              == request.resource.data.quantityChanged
            && request.resource.data.quantityOut == 0
          )
          ||
          (
            request.resource.data.quantityChanged < 0
            && request.resource.data.quantityIn == 0
            && request.resource.data.quantityOut
              == 0 - request.resource.data.quantityChanged
          )
          ||
          (
            request.resource.data.quantityChanged == 0
            && request.resource.data.quantityIn == 0
            && request.resource.data.quantityOut == 0
          )
        )
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.performedByName is string
        && request.resource.data.performedByName.size() >= 1
        && request.resource.data.performedByName.size() <= 150
        && request.resource.data.performedByRole
          == currentUserProfile().role
        && request.resource.data.transactionDate is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.get(
          "updatedAt",
          request.time
        ) == request.time;

      allow update, delete: if false;
    }

    /*
     * DENY EVERY COLLECTION NOT EXPLICITLY LISTED ABOVE.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
